---
import AppWrap from './AppWrap.astro';
import type { Testimonial } from '@/lib/content';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<AppWrap id="testimonials">
  <section class="mx-auto min-h-screen mt-28 w-full">
    {testimonials.length === 0 ? (
      <div>
        <h2>What others say?</h2>
        <p>No testimonials available at the moment.</p>
      </div>
    ) : (
      <div>
        <h2 class="text-2xl p-4 font-bold">Testimonials</h2>

        <div class="flex flex-col md:flex-row justify-around">
          {testimonials.map((testimonial) => (
            <div class="m-4 flex flex-col justify-center items-center">
              {testimonial.image && (
                <img
                  src={testimonial.image}
                  alt={`${testimonial.name} from ${testimonial.company}`}
                  class="w-[100px] h-[100px] rounded-lg object-cover"
                />
              )}
              <div class="font-bold text-xl mt-4">{testimonial.name}</div>
              <div class="text-xs uppercase px-2 py-0 text-opacity-70">
                {testimonial.company}
              </div>
              <div class="font-normal text-xs h-5 mt-1">
                {testimonial.message}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
</AppWrap>
