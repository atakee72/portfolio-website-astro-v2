---
import { cn } from '@/lib/utils';

interface Props {
  user: string;
  domain: string;
  class?: string;
  fallback?: string;
}

const {
  user,
  domain,
  class: cls = '',
  fallback = '[ JS required ]',
} = Astro.props;

const encode = (s: string) =>
  Array.from(s).map((c) => c.charCodeAt(0)).join(',');
---

<a
  data-ob-email
  data-u={encode(user)}
  data-d={encode(domain)}
  href="#"
  class={cn(cls)}
  onclick="return this.dataset.done==='1'"
>{fallback}</a>
