---
// Build-time fallback for no-JS visitors; live-updated by inline script below
const buildYear = new Date().getFullYear();
---

<footer
  class="
    mt-6 pt-3.5 pb-6
    px-4 md:px-6 lg:px-9
    border-t border-ink-3
    max-w-[1320px] mx-auto
    flex flex-col gap-2 lg:flex-row lg:justify-between lg:items-baseline
    text-[10px] tracking-[0.16em] text-mute
  "
>
  <span class="text-safelight">FRAME 36/36 — END OF ROLL</span>
  <span class="text-mute-2 font-mono normal-case tracking-[0.08em]">
    // built with astro · svelte · tailwind · cloudinary · vercel · web3forms
  </span>
  <span class="flex items-baseline gap-3">
    <span>© ATAK · <span data-year>{buildYear}</span></span>
    <span class="text-mute">
      VISITORS ·
      <span data-visitor-count class="inline-flex items-baseline gap-px text-phosphor font-mono">
        {Array.from({ length: 7 }).map(() => (
          <span class="bg-ink-3 px-0.5">·</span>
        ))}
      </span>
    </span>
    <a
      href="/rss.xml"
      class="text-mute-2 hover:text-phosphor transition-colors tracking-[0.16em]"
    >
      rss
    </a>
  </span>
</footer>

<script is:inline>
  let cachedPadded = null;
  let isAnimating = false;
  let countFetch = null;
  let pageAbort = null; // AbortController for current page's IO + hover listener

  function reducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function setDigits(el, str) {
    for (let i = 0; i < str.length && i < el.children.length; i++) {
      el.children[i].textContent = str[i];
    }
  }

  // Split-flap cascade: each digit cycles 0-9 then settles, left-to-right
  function animateCascade(el, padded) {
    if (isAnimating) return;
    isAnimating = true;
    const len = padded.length;
    const start = Date.now();
    const tickMs = 50;
    const settleStaggerMs = 80;
    const firstSettleMs = 200;
    function tick() {
      const elapsed = Date.now() - start;
      for (let i = 0; i < len; i++) {
        const settleAt = firstSettleMs + i * settleStaggerMs;
        const ch = elapsed >= settleAt ? padded[i] : String(Math.floor(Math.random() * 10));
        if (el.children[i]) el.children[i].textContent = ch;
      }
      const finalSettleAt = firstSettleMs + (len - 1) * settleStaggerMs;
      if (elapsed < finalSettleAt) {
        setTimeout(tick, tickMs);
      } else {
        setDigits(el, padded);
        isAnimating = false;
      }
    }
    tick();
  }

  function updateYear() {
    document.querySelectorAll('[data-year]').forEach((el) => {
      el.textContent = String(new Date().getFullYear());
    });
  }

  // Eager fetch (kicks off on page load); memoised across navigations
  function fetchCount() {
    if (countFetch) return countFetch;
    countFetch = (async () => {
      try {
        const res = await fetch('https://stats.ercan-atak.de/counter/TOTAL.json');
        if (!res.ok) return null;
        const data = await res.json();
        // +1337 offset is a deliberate '90s-counter-nostalgia wink; not a metrics bug
        const count = parseInt(data.count_unique || '0', 10) + 1337;
        cachedPadded = String(count).padStart(7, '0');
        return cachedPadded;
      } catch {
        return null;
      }
    })();
    return countFetch;
  }

  // Reveal = wait for both fetch + minimum dot-beat, then cascade
  // `signal` aborts if user navigates away during the await
  async function revealCounter(el, signal) {
    const minDotDelay = new Promise((r) => setTimeout(r, 600));
    const [padded] = await Promise.all([fetchCount(), minDotDelay]);
    if (!padded || signal.aborted) return;
    if (reducedMotion()) {
      setDigits(el, padded);
      return;
    }
    animateCascade(el, padded);
  }

  function wireCounter() {
    const targets = document.querySelectorAll('[data-visitor-count]');
    if (targets.length === 0) return;

    // Tear down any prior wiring (covers re-runs on same DOM, e.g. dev HMR)
    if (pageAbort) pageAbort.abort();
    pageAbort = new AbortController();
    const { signal } = pageAbort;

    // Kick off the fetch eagerly so data is ready by the time the user scrolls
    fetchCount();

    targets.forEach((el) => {
      // First viewport intersection triggers the reveal (cascade) once per page
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            io.unobserve(entry.target);
            revealCounter(el, signal);
          }
        });
      });
      io.observe(el);
      // Disconnect the observer when the page swaps away
      signal.addEventListener('abort', () => io.disconnect(), { once: true });

      // Re-trigger on hover (Easter egg). Auto-removed via abort signal on swap.
      el.addEventListener(
        'mouseenter',
        () => {
          if (cachedPadded && !reducedMotion()) {
            animateCascade(el, cachedPadded);
          }
        },
        { signal }
      );
    });
  }

  function cleanupCounter() {
    if (pageAbort) {
      pageAbort.abort();
      pageAbort = null;
    }
  }

  document.addEventListener('astro:page-load', updateYear);
  document.addEventListener('astro:page-load', wireCounter);
  document.addEventListener('astro:before-swap', cleanupCounter);
</script>
