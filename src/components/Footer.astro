---
const year = new Date().getFullYear();
---

<footer
  class="
    mt-6 pt-3.5 pb-6
    px-4 md:px-6 lg:px-9
    border-t border-ink-3
    max-w-[1320px] mx-auto
    flex flex-col gap-2 lg:flex-row lg:justify-between lg:items-baseline
    text-[10px] tracking-[0.16em] text-mute
  "
>
  <span class="text-safelight">FRAME 36/36 — END OF ROLL</span>
  <span class="text-mute-2 font-mono normal-case tracking-[0.08em]">
    // built with astro · svelte · tailwind · cloudinary · vercel · web3forms
  </span>
  <span>
    <a href="mailto:contact@ercan-atak.de" class="text-phosphor hover:underline normal-case tracking-[0.06em]">contact@ercan-atak.de</a>
    <span class="text-mute-2"> · </span>
    © ATAK · {year}
  </span>
</footer>
