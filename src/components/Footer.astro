---
const year = new Date().getFullYear();
---

<footer
  class="
    mt-6 pt-3.5 pb-6
    px-4 md:px-6 lg:px-9
    border-t border-ink-3
    max-w-[1320px] mx-auto
    flex flex-col gap-2 lg:flex-row lg:justify-between lg:items-baseline
    text-[10px] tracking-[0.16em] text-mute
  "
>
  <span class="text-safelight">FRAME 36/36 — END OF ROLL</span>
  <span class="text-mute-2 font-mono normal-case tracking-[0.08em]">
    // built with astro · svelte · tailwind · cloudinary · vercel · web3forms
  </span>
  <span class="flex items-baseline gap-3">
    <span>© ATAK · {year}</span>
    <span class="text-mute">
      VISITORS · <span data-visitor-count class="text-phosphor">·······</span>
    </span>
    <a
      href="/rss.xml"
      class="text-mute-2 hover:text-phosphor transition-colors tracking-[0.16em]"
    >
      rss
    </a>
  </span>
</footer>

<script is:inline>
  async function updateVisitorCount() {
    try {
      const res = await fetch('https://stats.ercan-atak.de/counter/TOTAL.json');
      if (!res.ok) return;
      const data = await res.json();
      // +1337 offset is a deliberate '90s-counter-nostalgia wink; not a metrics bug
      const count = parseInt(data.count_unique || '0', 10) + 1337;
      const padded = String(count).padStart(7, '0');
      const targets = document.querySelectorAll('[data-visitor-count]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced) {
        targets.forEach((el) => {
          el.textContent = padded;
        });
        return;
      }

      // Split-flap cascade: each digit cycles 0-9 then settles, left-to-right
      targets.forEach((el) => {
        const len = padded.length;
        const start = Date.now();
        const tickMs = 50;
        const settleStaggerMs = 80;
        const firstSettleMs = 200;
        function tick() {
          const elapsed = Date.now() - start;
          let display = '';
          for (let i = 0; i < len; i++) {
            const settleAt = firstSettleMs + i * settleStaggerMs;
            display += elapsed >= settleAt ? padded[i] : Math.floor(Math.random() * 10);
          }
          el.textContent = display;
          const finalSettleAt = firstSettleMs + (len - 1) * settleStaggerMs;
          if (elapsed < finalSettleAt) {
            setTimeout(tick, tickMs);
          } else {
            el.textContent = padded;
          }
        }
        tick();
      });
    } catch {
      /* silent — counter stays as placeholder */
    }
  }
  document.addEventListener('astro:page-load', updateVisitorCount);
</script>
