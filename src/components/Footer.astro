---
const year = new Date().getFullYear();
---

<footer
  class="
    mt-6 pt-3.5 pb-6
    px-4 md:px-6 lg:px-9
    border-t border-ink-3
    max-w-[1320px] mx-auto
    flex flex-col gap-2 lg:flex-row lg:justify-between lg:items-baseline
    text-[10px] tracking-[0.16em] text-mute
  "
>
  <span class="text-safelight">FRAME 36/36 — END OF ROLL</span>
  <span class="text-mute-2 font-mono normal-case tracking-[0.08em]">
    // built with astro · svelte · tailwind · cloudinary · vercel · web3forms
  </span>
  <span class="flex items-baseline gap-3">
    <span>© ATAK · {year}</span>
    <span class="text-mute">
      VISITORS ·
      <span data-visitor-count class="inline-flex items-baseline gap-px text-phosphor font-mono">
        {Array.from({ length: 7 }).map(() => (
          <span class="bg-ink-3 px-0.5">·</span>
        ))}
      </span>
    </span>
    <a
      href="/rss.xml"
      class="text-mute-2 hover:text-phosphor transition-colors tracking-[0.16em]"
    >
      rss
    </a>
  </span>
</footer>

<script is:inline>
  let cachedPadded = null;
  let isAnimating = false;

  function reducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  // Write each char of `str` into the corresponding child digit-slot of `el`
  function setDigits(el, str) {
    for (let i = 0; i < str.length && i < el.children.length; i++) {
      el.children[i].textContent = str[i];
    }
  }

  // Split-flap cascade: each digit cycles 0-9 then settles, left-to-right
  function animateCascade(el, padded) {
    if (isAnimating) return;
    isAnimating = true;
    const len = padded.length;
    const start = Date.now();
    const tickMs = 50;
    const settleStaggerMs = 80;
    const firstSettleMs = 200;
    function tick() {
      const elapsed = Date.now() - start;
      for (let i = 0; i < len; i++) {
        const settleAt = firstSettleMs + i * settleStaggerMs;
        const ch = elapsed >= settleAt ? padded[i] : String(Math.floor(Math.random() * 10));
        if (el.children[i]) el.children[i].textContent = ch;
      }
      const finalSettleAt = firstSettleMs + (len - 1) * settleStaggerMs;
      if (elapsed < finalSettleAt) {
        setTimeout(tick, tickMs);
      } else {
        setDigits(el, padded);
        isAnimating = false;
      }
    }
    tick();
  }

  async function updateVisitorCount() {
    try {
      const res = await fetch('https://stats.ercan-atak.de/counter/TOTAL.json');
      if (!res.ok) return;
      const data = await res.json();
      // +1337 offset is a deliberate '90s-counter-nostalgia wink; not a metrics bug
      const count = parseInt(data.count_unique || '0', 10) + 1337;
      cachedPadded = String(count).padStart(7, '0');
      const targets = document.querySelectorAll('[data-visitor-count]');

      if (reducedMotion()) {
        targets.forEach((el) => setDigits(el, cachedPadded));
        return;
      }

      targets.forEach((el) => {
        animateCascade(el, cachedPadded);
        // Re-trigger on hover (Easter egg, no cursor change to preserve subtlety)
        if (!el.dataset.hoverWired) {
          el.dataset.hoverWired = 'true';
          el.addEventListener('mouseenter', () => {
            if (cachedPadded && !reducedMotion()) {
              animateCascade(el, cachedPadded);
            }
          });
        }
      });
    } catch {
      /* silent — counter stays as placeholder */
    }
  }
  document.addEventListener('astro:page-load', updateVisitorCount);
</script>
