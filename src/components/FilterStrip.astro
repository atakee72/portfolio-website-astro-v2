---
interface Props {
  tags: string[];
  label?: string;
  name?: string;
}

const { tags, label = '// filter', name } = Astro.props;
---

{tags.length > 0 && (
  <div
    role="group"
    aria-label={`Filter by ${name ?? 'tag'}`}
    data-filter-strip
    data-filter-name={name}
    class="flex flex-wrap items-center gap-2 mb-6 font-mono text-[10px] tracking-[0.16em] uppercase"
  >
    <span class="text-mute-2">{label}</span>
    <button
      type="button"
      data-filter-chip="all"
      aria-pressed="true"
      class="filter-chip px-2 py-0.5 border transition-colors"
    >
      all
    </button>
    {tags.map((t) => (
      <button
        type="button"
        data-filter-chip={t}
        aria-pressed="false"
        class="filter-chip px-2 py-0.5 border transition-colors"
      >
        {t}
      </button>
    ))}
  </div>
)}

<style is:global>
  .filter-hidden {
    display: none;
  }

  .filter-chip {
    border-color: #2a2a28;
    color: #6a6a66;
  }
  .filter-chip:hover {
    color: #e8e5dd;
    border-color: #e8e5dd;
  }
  .filter-chip[aria-pressed='true'] {
    border-color: #d4ff3a;
    color: #d4ff3a;
  }
</style>

<script>
  type Win = Window & { __filterStripWired?: boolean };
  if (!(window as Win).__filterStripWired) {
    (window as Win).__filterStripWired = true;

    // Read the value(s) on an item for a given axis.
    // Legacy axis ('tags' = no data-filter-name) reads from data-tags.
    // New axes read from data-filter-<axis>.
    const itemValuesForAxis = (item: HTMLElement, axis: string): string[] => {
      const attr =
        axis === 'tags' ? 'data-tags' : `data-filter-${axis}`;
      return (item.getAttribute(attr) ?? '').split('|').filter(Boolean);
    };

    // Re-evaluate every item on the page against every strip on the page.
    // An item is visible iff it passes ALL axes' active filters.
    const applyFilters = () => {
      const strips = document.querySelectorAll<HTMLElement>(
        '[data-filter-strip]',
      );
      type AxisFilter = { axis: string; active: string };
      const axes: AxisFilter[] = [];
      strips.forEach((s) => {
        const axis = s.getAttribute('data-filter-name') ?? 'tags';
        const activeChip = s.querySelector<HTMLButtonElement>(
          '[data-filter-chip][aria-pressed="true"]',
        );
        axes.push({
          axis,
          active: activeChip?.getAttribute('data-filter-chip') ?? 'all',
        });
      });

      // Union selector: legacy items (data-tags) AND new items (data-filter-item).
      const items = document.querySelectorAll<HTMLElement>(
        '[data-filter-target] [data-filter-item], [data-filter-target] [data-tags]',
      );
      let visible = 0;
      items.forEach((item) => {
        let show = true;
        for (const { axis, active } of axes) {
          if (active === 'all') continue;
          const values = itemValuesForAxis(item, axis);
          if (!values.includes(active)) {
            show = false;
            break;
          }
        }
        item.classList.toggle('filter-hidden', !show);
        if (show) visible++;
      });

      document
        .querySelectorAll<HTMLElement>('[data-filter-count]')
        .forEach((el) => {
          el.textContent = String(visible);
        });
    };

    document.addEventListener('click', (e) => {
      const chip = (e.target as Element | null)?.closest<HTMLButtonElement>(
        '[data-filter-chip]',
      );
      if (!chip) return;
      const strip = chip.closest('[data-filter-strip]');
      if (!strip) return;
      strip
        .querySelectorAll<HTMLButtonElement>('[data-filter-chip]')
        .forEach((c) => {
          c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
        });
      applyFilters();
    });
  }
</script>
