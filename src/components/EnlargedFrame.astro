---
import type { Frame } from '@/data/contactSheet';
import { photoBg, paintBg } from '@/data/contactSheet';
import CloudPhoto from './CloudPhoto.astro';

interface Props {
  id: string;
  frame?: Extract<Frame, { k: 'photo' | 'paint' }>;
  imageCldPath?: string;
  imageAlt?: string;
  label?: string;
  tag?: string;
  caption?: string;
  exifLine?: string;
  rollSlug?: string;
  /** Generic CTA link in the caption row (e.g. paint cells → painting page). */
  ctaHref?: string;
  ctaLabel?: string;
  permalinkHref?: string;
  showNav?: boolean;
  /** Letterbox the image (whole artwork visible) instead of cropping to 4:3. */
  fitContain?: boolean;
}

const {
  id,
  frame,
  imageCldPath,
  imageAlt,
  label,
  tag,
  caption,
  exifLine,
  rollSlug,
  ctaHref,
  ctaLabel,
  permalinkHref,
  showNav = false,
  fitContain = false,
} = Astro.props;

const resolvedLabel = label ?? frame?.label;
const resolvedTag = tag ?? frame?.tag;
const tagIsSafelight = frame?.k === 'paint';

const bgStyle = imageCldPath
  ? undefined
  : frame
    ? frame.k === 'photo'
      ? photoBg(frame.tone)
      : paintBg(frame.tone)
    : undefined;
---

<div
  class="enlarged-frame-modal"
  role="dialog"
  aria-modal="true"
  aria-label={resolvedLabel}
  data-modal-id={id}
  hidden
>
  <div class="frame-wrapper">
    {showNav && (
      <>
        <button
          type="button"
          data-nav-prev
          aria-label="Previous photo"
          class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
            ></path>
          </svg>
        </button>
        <button
          type="button"
          data-nav-next
          aria-label="Next photo"
          class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
            ></path>
          </svg>
        </button>
      </>
    )}

    {permalinkHref && (
      <button
        type="button"
        data-copy-link={permalinkHref}
        aria-label="Copy link to this photo"
        class="copy-link-btn absolute top-3 right-14 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
      >
        <svg
          class="copy-icon w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z"
          ></path>
        </svg>
        <svg
          class="check-icon w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
          ></path>
        </svg>
        <span class="copied-label">copied</span>
      </button>
    )}

    <button
      type="button"
      data-close
      aria-label="Close enlarged view"
      class="absolute top-3 right-3 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="w-4 h-4"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
        ></path>
      </svg>
    </button>

    <div class:list={['frame', fitContain && 'bg-ink-2']} style={bgStyle}>
      {imageCldPath && (
        <CloudPhoto
          cldPath={imageCldPath}
          alt={imageAlt ?? resolvedLabel ?? ''}
          width={2000}
          loading="eager"
          class="absolute inset-0 w-full h-full"
          imgClass={fitContain ? 'h-full' : undefined}
          objectFit={fitContain ? 'contain' : undefined}
        />
      )}

      {resolvedTag && (
        <span
          class:list={[
            'absolute top-3 left-3 z-20 text-[11px] tracking-[0.14em] px-2 py-1 bg-black/50 border',
            tagIsSafelight
              ? 'text-safelight border-safelight'
              : 'text-paper border-paper',
          ]}
        >
          {resolvedTag}
        </span>
      )}

      <div
        class="absolute left-3 right-3 bottom-3 z-20 flex justify-between items-end gap-3 text-[12px] tracking-[0.16em] text-phosphor"
      >
        <div class="bg-ink-2 border border-ink-3 px-3 py-2">
          {resolvedLabel && <div>{resolvedLabel}</div>}
          {caption && (
            <div class="text-phosphor/80 normal-case tracking-[0.04em] mt-1">{caption}</div>
          )}
          {exifLine && (
            <div class="text-phosphor/60 font-mono text-[11px] tracking-[0.08em] mt-1">
              {exifLine}
            </div>
          )}
        </div>
        {rollSlug && (
          <a
            href={`/lens/${rollSlug}`}
            class="bg-ink-2 border border-ink-3 px-3 py-2 hover:text-paper transition-colors shrink-0"
          >
            see full roll →
          </a>
        )}
        {ctaHref && (
          <a
            href={ctaHref}
            class="bg-ink-2 border border-ink-3 px-3 py-2 hover:text-paper transition-colors shrink-0"
          >
            {ctaLabel ?? 'view →'}
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .enlarged-frame-modal {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 12, 0.88);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 220ms;
  }

  .enlarged-frame-modal[data-open] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 0s;
  }

  .enlarged-frame-modal .frame-wrapper {
    position: relative;
    width: min(90vw, 1100px);
    aspect-ratio: 4 / 3;
    max-height: 86vh;
    transform: scale(0.96);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .enlarged-frame-modal[data-open] .frame-wrapper {
    transform: scale(1);
  }

  .enlarged-frame-modal .frame {
    position: relative;
    width: 100%;
    height: 100%;
    border: 1px solid #2a2a28;
    overflow: hidden;
  }

  /* Copy-link button: link icon by default, swaps to a checkmark + small
     "copied" label flash when its data-state is "copied" (set briefly by
     the inline script below). Phosphor bg for the success state. */
  .copy-link-btn .check-icon,
  .copy-link-btn .copied-label {
    display: none;
  }
  .copy-link-btn[data-state='copied'] {
    background-color: #00ff66;
    color: #0d0d0c;
    border-color: #00ff66;
    width: auto;
    padding: 0 0.6rem;
    gap: 0.4rem;
  }
  .copy-link-btn[data-state='copied'] .copy-icon {
    display: none;
  }
  .copy-link-btn[data-state='copied'] .check-icon,
  .copy-link-btn[data-state='copied'] .copied-label {
    display: inline-flex;
  }
  .copy-link-btn[data-state='copied'] .copied-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>

<script>
  // Modal wiring for every EnlargedFrame on the page — the ONE copy of this
  // script (pages must not ship their own). Hoisted by Astro so it runs once,
  // delegating on `document`, which persists across View Transitions; the
  // flag prevents duplicate listeners if the script re-executes.
  type WiredWindow = Window & { __enlargeWired?: boolean };
  if (!(window as WiredWindow).__enlargeWired) {
    (window as WiredWindow).__enlargeWired = true;

    let activeModal: HTMLElement | null = null;
    let lastTrigger: HTMLElement | null = null;
    let inertedSiblings: HTMLElement[] = [];

    const openModal = (modal: HTMLElement, trigger: HTMLElement) => {
      lastTrigger = trigger;
      activeModal = modal;
      // Move to body so inerting siblings doesn't inert the modal itself
      // (`inert` cascades to descendants; the modal renders inside the
      // section that gets inerted).
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
      modal.removeAttribute('hidden');
      // Force layout so the transition runs from the hidden state.
      void modal.offsetWidth;
      modal.setAttribute('data-open', '');
      // Lock background scroll while the modal is open (inert alone
      // doesn't stop wheel/touch scrolling on the document).
      document.documentElement.style.overflow = 'hidden';
      const closeBtn = modal.querySelector('[data-close]') as HTMLButtonElement | null;
      closeBtn?.focus();
      inertedSiblings = [];
      for (const child of Array.from(document.body.children)) {
        const el = child as HTMLElement;
        if (el !== modal && !el.hasAttribute('inert')) {
          el.setAttribute('inert', '');
          inertedSiblings.push(el);
        }
      }
    };

    const closeModal = () => {
      if (!activeModal) return;
      const modal = activeModal;
      modal.removeAttribute('data-open');
      // Hide after the opacity transition ends so the modal stays in
      // the layout tree during the fade-out.
      window.setTimeout(() => {
        if (modal && !modal.hasAttribute('data-open')) {
          modal.setAttribute('hidden', '');
        }
      }, 230);
      for (const el of inertedSiblings) el.removeAttribute('inert');
      inertedSiblings = [];
      document.documentElement.style.overflow = '';
      lastTrigger?.focus();
      activeModal = null;
    };

    // Navigating away with the modal open (e.g. its CTA link) skips
    // closeModal, and <html> persists across View Transitions — release
    // the scroll lock and stale state before every swap.
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.style.overflow = '';
      inertedSiblings = [];
      activeModal = null;
      lastTrigger = null;
    });

    // Only triggers the viewer can currently see — filter strips hide grid
    // items with display:none, and hidden items must not join the cycle.
    const visibleTriggers = () =>
      (Array.from(document.querySelectorAll('[data-enlarge-target]')) as HTMLElement[])
        .filter((t) => t.offsetParent !== null);

    const navigate = (delta: number) => {
      if (!activeModal) return;
      const triggers = visibleTriggers();
      if (triggers.length < 2) return;
      const currentId = activeModal.getAttribute('data-modal-id');
      const idx = triggers.findIndex(
        (t) => t.getAttribute('data-enlarge-target') === currentId,
      );
      if (idx < 0) return;
      const nextIdx = (idx + delta + triggers.length) % triggers.length;
      const nextTrigger = triggers[nextIdx];
      const nextId = nextTrigger.getAttribute('data-enlarge-target');
      if (!nextId) return;
      const nextModal = document.querySelector(
        `[data-modal-id="${nextId}"]`,
      ) as HTMLElement | null;
      if (!nextModal) return;

      activeModal.removeAttribute('data-open');
      activeModal.setAttribute('hidden', '');
      for (const el of inertedSiblings) el.removeAttribute('inert');
      inertedSiblings = [];
      activeModal = null;

      openModal(nextModal, nextTrigger);
    };

    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (!target) return;

      const trigger = target.closest('[data-enlarge-target]') as HTMLElement | null;
      if (trigger) {
        if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
          // No modal on mobile — tap-navigate to the linked page instead.
          const permalink = trigger.getAttribute('data-permalink');
          if (permalink) window.location.href = permalink;
          return;
        }
        const id = trigger.getAttribute('data-enlarge-target');
        if (!id) return;
        const modal = document.querySelector(`[data-modal-id="${id}"]`) as HTMLElement | null;
        if (modal) openModal(modal, trigger);
        return;
      }

      if (target.closest('[data-nav-prev]')) {
        navigate(-1);
        return;
      }
      if (target.closest('[data-nav-next]')) {
        navigate(1);
        return;
      }

      if (target.closest('[data-close]')) {
        closeModal();
        return;
      }

      // Backdrop click: the click target is the modal element itself
      // (not a child). The frame-wrapper child blocks bubbles inside.
      if (activeModal && target === activeModal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!activeModal) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        navigate(-1);
        return;
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        navigate(1);
        return;
      }
      if (e.key === 'Tab') {
        // Trap focus inside the modal.
        const focusable = activeModal.querySelectorAll(
          'button, [href], input, textarea, select, [tabindex]:not([tabindex="-1"])',
        ) as NodeListOf<HTMLElement>;
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          last.focus();
          e.preventDefault();
        } else if (!e.shiftKey && document.activeElement === last) {
          first.focus();
          e.preventDefault();
        }
      }
    });
  }

  // Copy-link click handler. Hoisted by Astro so it runs once per page,
  // delegating across every EnlargedFrame instance.
  if (!(window as Window & { __copyLinkWired?: boolean }).__copyLinkWired) {
    (window as Window & { __copyLinkWired?: boolean }).__copyLinkWired = true;

    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element | null)?.closest(
        '[data-copy-link]',
      ) as HTMLButtonElement | null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      const href = btn.getAttribute('data-copy-link');
      if (!href) return;
      const absoluteUrl = new URL(href, location.origin).href;

      try {
        await navigator.clipboard.writeText(absoluteUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = absoluteUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }

      btn.setAttribute('data-state', 'copied');
      window.setTimeout(() => btn.removeAttribute('data-state'), 1600);
    });
  }
</script>
