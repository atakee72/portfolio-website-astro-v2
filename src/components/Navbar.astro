---
import LiveClock from './LiveClock.svelte';
import MobileMenuBtn from './MobileMenuBtn.svelte';
import { navItems } from '@/data/nav';

const cmd = './develop --contact-sheet 2026';
const isHomepage = Astro.url.pathname === '/';
---

<nav
  class="
    sticky top-0 z-chrome flex items-center gap-2
    bg-ink-2 border border-ink-3
    px-3.5 py-2.5
    text-[11px] tracking-[0.04em] font-mono
  "
  aria-label="Site status"
>
  <span class="w-2 h-2 bg-phosphor rounded-full" aria-hidden="true"></span>
  <a
    href="/"
    class="text-phosphor hover:text-paper transition-colors"
    aria-label="Home"
  >ercan@darkroom</a>
  <span class:list={['text-mute', !isHomepage && 'lg:hidden']}>:</span>
  <span class:list={['text-mute-2', !isHomepage && 'lg:hidden']}>~/portfolio</span>
  <span class:list={['text-mute', !isHomepage && 'lg:hidden']}>$</span>
  <span class:list={['text-paper hidden sm:inline', !isHomepage && 'lg:hidden']}>{cmd}</span>

  {!isHomepage && (
    <ul class="hidden lg:flex flex-wrap items-baseline gap-3 list-none p-0 m-0 text-[10px] tracking-[0.16em] uppercase">
      {navItems.map((n) => (
        <li>
          <a
            href={n.href}
            class="text-paper hover:text-phosphor transition-colors"
          >
            {n.label}
          </a>
        </li>
      ))}
    </ul>
  )}

  <span class="flex-1"></span>

  <span class="text-mute-2 tracking-[0.12em] hidden lg:inline">
    BERLIN · 12049
  </span>
  <LiveClock client:idle class="text-mute-2 tracking-[0.12em] hidden md:inline" />
  <span class="text-safelight font-bold tracking-[0.16em]">● REC</span>

  <div class="lg:hidden">
    <MobileMenuBtn client:only="svelte" />
  </div>
</nav>
