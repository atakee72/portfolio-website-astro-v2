---
const projects = [
  {
    title: ['Home~made', 'Facebook', 'for my', 'Neighbours'],
    url: 'https://mahalle-kiez-gesichterbuch.vercel.app',
    image: '/assets/maHalle.png',
    alt: 'Logo of MaHalle',
    tech: ['Next.js', 'MongoDB', 'NextAuth', 'Tailwind'],
  },
  {
    title: ['Can', 'Dogs', '&', 'Movies', 'go together'],
    url: 'https://dogs-n-films-catalog-app.vercel.app',
    image: '/assets/graduate.jpg',
    alt: 'Cover picture of Dogs and Movies',
    tech: ['Next.js', 'Tailwind'],
    specialTitle: true,
  },
  {
    title: ['Yet', 'another', 'admin', 'dashboard'],
    url: '#',
    image: '/assets/dashboard.png',
    alt: 'Cover picture of the Dashboard',
    tech: ['Next.js', 'Sass'],
    specialTitle2: true,
  },
];
---

<div class="mt-5 p-6 bg-primary gap-5 flex font-semibold text-xl 2xl:w-[1600px] xl:w-[1400px] lg:w-[1200px] md:w-[1000px] sm:w-[800px] h-[550px] rounded-sm overflow-hidden">
  {projects.map((project, index) => (
    <a
      href={project.url}
      target={project.url !== '#' ? '_blank' : undefined}
      rel={project.url !== '#' ? 'noopener noreferrer' : undefined}
      class="relative w-1/3 transition-all duration-500 hover:w-2/3"
    >
      <img
        src={project.image}
        alt={project.alt}
        class="h-full w-full rounded-sm object-cover aspect-auto"
      />
      <div class="absolute font-sans font-normal tracking-widest leading-9 box-border m-0 flex flex-col items-start justify-center text-primary text-5xl top-0 left-0 z-20 w-full h-full bg-secondary/80 uppercase">
        {project.specialTitle ? (
          <>
            <h1>{project.title[0]}</h1>
            <h1>{project.title[1]}</h1>
            <h1 class="absolute left-56">{project.title[2]}</h1>
            <h1>{project.title[3]}</h1>
            <h1>{project.title[4]}</h1>
            <span class="absolute top-[322px] left-[350px] rotate-180">?</span>
          </>
        ) : project.specialTitle2 ? (
          <>
            <h1>{project.title[0]}</h1>
            <h1>{project.title[1]}</h1>
            <h1>{project.title[2]}</h1>
            <h1>{project.title[3]}</h1>
            <span class="absolute top-[293px] left-[330px] rotate-45">!</span>
          </>
        ) : (
          project.title.map((line) => <h1>{line}</h1>)
        )}
      </div>
      <div class="techBadges font-light absolute bottom-1 z-40 text-primary text-xs">
        {project.tech.map((tech) => (
          <span class="bg-secondary/70 py-[1px] pl-1 pr-2 mb-1 ml-1 z-40 rounded-s-sm rounded-e-lg text-xs">
            {tech}
          </span>
        ))}
      </div>
    </a>
  ))}
</div>
