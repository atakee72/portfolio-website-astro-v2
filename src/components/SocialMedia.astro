---
const links = [
  { abbr: 'GH', name: 'GitHub', url: 'https://github.com/atakee72' },
  { abbr: 'IN', name: 'LinkedIn', url: 'https://linkedin.com/in/ercan-atak' },
  { abbr: 'BE', name: 'Behance', url: 'https://www.behance.net/E-Atak-Photography' },
  { abbr: 'IG', name: 'Instagram', url: 'https://www.instagram.com/a_t_a_k_e_e/' },
  { abbr: 'FB', name: 'Facebook', url: 'https://facebook.com/atakee72' },
];
---

<nav class="social-rail" aria-label="Social links">
  {links.map((item) => (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={item.name}
      class="social-rail__link"
    >
      <span class="social-rail__label">{item.abbr}</span>
    </a>
  ))}
</nav>

<style>
  .social-rail {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: none;
    box-sizing: border-box;
    width: 48px;
    padding: 0.75rem 0;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    border-right: 1px solid #2a2a28;
  }

  @media (min-width: 1416px) {
    .social-rail {
      display: flex;
      left: calc((100vw - 1320px) / 2 - 48px);
    }
  }

  .social-rail__link {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .social-rail__label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: #9a9a92;
    transition: color 180ms ease-out;
  }

  .social-rail__link:hover .social-rail__label,
  .social-rail__link:focus-visible .social-rail__label {
    color: #ff3b30;
  }

  .social-rail__link::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 0;
    height: 1px;
    background: #ff3b30;
    transition: width 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .social-rail__link:hover::after,
  .social-rail__link:focus-visible::after {
    width: 24px;
  }
</style>
