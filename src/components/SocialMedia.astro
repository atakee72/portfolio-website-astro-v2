<div class="absolute flex justify-end items-center flex-col p-4">
  {socialLinks.map((item) => (
    <div class="group">
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={item.name}
        style={`--brand: ${item.brand}`}
        class="hidden xs:flex w-10 h-10 rounded-full bg-white mx-1 my-1 border border-lightGray justify-center items-center transition-colors duration-200 group-hover:border-[var(--brand)] group-hover:shadow"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox={item.viewBox}
          fill="currentColor"
          class={`${item.sizeClass} text-gray transition-colors duration-200 group-hover:text-[var(--brand)]`}
          aria-hidden="true"
        >
          <path d={item.path}></path>
        </svg>
      </a>
    </div>
  ))}
</div>
