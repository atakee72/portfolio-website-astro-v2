---
import AppWrap from './AppWrap.astro';
import { FEATURES } from '@/lib/config';
import ReachForm from './ReachForm.svelte';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
---

<AppWrap id="about" className="!min-h-0 block">
  <section
    class="
      px-4 py-6 md:px-6 md:py-7 lg:px-9 lg:py-9
      max-w-[1320px] mx-auto
    "
  >
    <h2 class="m-0 text-[13px] text-mute-2 tracking-[0.18em] uppercase mb-4">
      // ABOUT
    </h2>

    <aside id="reach-form" class="bg-ink-2 border border-ink-3 px-4 py-3.5">
      <div class="text-[10px] text-mute-2 tracking-[0.18em] pb-2.5 mb-3 border-b border-ink-3 uppercase">
        ~/about
      </div>

      <div class="lg:grid lg:grid-cols-2 lg:gap-x-8 lg:items-start">
        <pre class="m-0 text-[12px] leading-[1.7] text-paper whitespace-pre-wrap font-mono lg:col-start-1 lg:row-start-1"><span class="text-safelight">$</span> whoami
ercan atak — full-stack, half-painter,
            born Istanbul, in Berlin since 2007,
            Neukölln 12049

<span class="text-safelight">$</span> stack
typescript · astro · react · svelte · node
postgres · mongo · openai · claude · vercel · supabase

<span class="text-safelight">$</span> build
intelligent apps · agent orchestration
content-driven sites · design-engineer work{FEATURES.AVAILABILITY && (<>

<span class="text-safelight">$</span> status
<span class="text-phosphor">●</span> available for projects · remote or berlin
</>)}

<span class="text-safelight">$</span> reach
<ObfuscatedEmail user="contact" domain="ercan-atak.de" class="text-phosphor hover:underline" fallback="[ ENC ]" /> · or use the form <span class="lg:hidden">below ↓</span><span class="hidden lg:inline">→</span></pre>

        <div class="mt-3 lg:mt-0 lg:col-start-2 lg:row-start-1">
          <ReachForm client:visible />
        </div>

        <pre class="m-0 mt-3 lg:mt-2 text-[12px] leading-[1.7] text-paper whitespace-pre-wrap font-mono lg:col-start-1 lg:row-start-2"><span class="text-safelight">$</span> <span class="darkroom-caret"></span></pre>
      </div>
    </aside>
  </section>
</AppWrap>
