---
import AppWrap from './AppWrap.astro';
import MyAccordion from './MyAccordion.astro';
---

<AppWrap id="home">
  <section class="w-full min-h-screen flex flex-col items-center justify-items-start mt-28">
    <div>
      <div class="animate-slidein300 flex flex-col items-center text-white hover:text-secondary dark:hover:text-white font-semibold mb-10 text-3xl">
        <p class="text-4xl xxs:text-5xl text-center">Web Developer</p>
      </div>

      <div
        class="m-auto animate-slidein500 w-48 h-48 xxs:w-56 xxs:h-56 xs:w-60 xs:h-60 sm:w-64 sm:h-64 lg:w-72 lg:h-72 xl:w-[300px] xl:h-[300px] rounded-full bg-secondary/50 shadow-lg"
        style="box-shadow: -100px 10px 80px 20px #080707 inset"
      ></div>

      <MyAccordion />
    </div>
  </section>
</AppWrap>
