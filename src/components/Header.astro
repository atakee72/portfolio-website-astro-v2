---
import AppWrap from './AppWrap.astro';
import TerminalFeed from './TerminalFeed.astro';
import ContactSheet from './ContactSheet.astro';
import SprocketRow from './SprocketRow.astro';

const heroMeta = 'ROLL 12 · F/2.8 · 1/250 · ISO 400';
const heroLines = ['ercan', 'atak'];
const tagline = '// dev · photog · painter';
const stackline = '// building intelligent apps · ts/astro/react/svelte · berlin';
const intro = `I keep three darkrooms: one for software, one for film, one for paint.
Software-side I build intelligent apps — AI-augmented full-stack, agent
orchestration, polished surfaces. Below is the latest contact sheet.`;

// Anchors per audit finding C in the redesign plan.
const navItems: { label: string; href: string }[] = [
  { label: 'home', href: '#home' },
  { label: 'sheet', href: '#sheet' },
  { label: 'journal', href: '#blog' },
  { label: 'rolls', href: '/lens' },
  { label: 'paints', href: '/paints' },
  { label: 'reach', href: '#reach-form' },
];
---

<AppWrap id="home" className="!min-h-0 block">
  <section
    class="
      grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-6 lg:gap-8
      px-4 pt-4 pb-6 md:px-6 md:pt-6 md:pb-7 lg:px-9 lg:pt-9 lg:pb-7
      max-w-[1320px] mx-auto
    "
  >
    <div>
      <p class="text-[11px] text-mute-2 tracking-[0.16em] mb-5">{heroMeta}</p>

      <h1
        class="
          m-0 flex flex-col leading-[0.88] font-display font-bold
          text-paper-hi text-[clamp(64px,12vw,124px)] tracking-[-0.04em]
        "
      >
        {heroLines.map((line) => <span>{line}</span>)}
      </h1>

      <p class="font-mono text-[13px] text-phosphor tracking-[0.08em] mt-4">
        {tagline}
      </p>
      <p class="font-mono text-[12px] text-mute-2 tracking-[0.08em] mt-1">
        {stackline}
      </p>

      <p class="max-w-[500px] text-[13px] text-paper-2 mt-6 leading-[1.6]">
        {intro}
      </p>

      <ul class="flex flex-wrap gap-x-4 gap-y-2 list-none p-0 mt-7 text-[12px] tracking-[0.14em] uppercase text-paper">
        {navItems.map((n, i) => (
          <li>
            <a href={n.href} class="hover:text-phosphor transition-colors">
              <em class="not-italic text-safelight text-[10px] mr-1.5">
                {String(i + 1).padStart(2, '0')}
              </em>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <TerminalFeed />
  </section>

  <SprocketRow />
  <ContactSheet />
  <SprocketRow />
</AppWrap>
