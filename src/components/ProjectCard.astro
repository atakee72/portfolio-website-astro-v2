---
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const { data, slug } = project;
const { exif } = data;
---

<a
  href={`/work/${slug}`}
  class="
    flex flex-col gap-1
    border border-ink-3 bg-ink-2 px-4 py-4
    transition-colors hover:bg-[#1e1e22]
  "
>
  <span class="text-[10px] text-safelight tracking-[0.18em]">
    {String(index + 1).padStart(2, '0')}/{String(total).padStart(2, '0')}
  </span>

  <h3 class="font-display font-bold text-[26px] text-paper-hi mt-2 tracking-[-0.02em]">
    {data.title}
  </h3>

  <p class="text-[12px] text-paper-2 mb-3">{data.subtitle}</p>

  <dl class="border-t border-b border-dashed border-ink-3 py-2.5 flex flex-col gap-1 m-0">
    <div class="flex justify-between text-[10px] text-mute-2 tracking-[0.10em]">
      <dt>STACK</dt><dd class="text-paper m-0">· {exif.stack}</dd>
    </div>
    <div class="flex justify-between text-[10px] text-mute-2 tracking-[0.10em]">
      <dt>YEAR</dt><dd class="text-paper m-0">· {exif.year}</dd>
    </div>
    <div class="flex justify-between text-[10px] text-mute-2 tracking-[0.10em]">
      <dt>STATUS</dt>
      <dd
        class:list={[
          'm-0',
          exif.status === 'live'
            ? 'text-phosphor'
            : exif.status === 'wip'
              ? 'text-safelight'
              : 'text-mute',
        ]}
      >
        · {exif.status}
      </dd>
    </div>
  </dl>

  <span class="text-[11px] text-phosphor tracking-[0.12em] uppercase mt-2.5">
    open frame →
  </span>
</a>
