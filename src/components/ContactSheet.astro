---
import { contactSheet, photoBg, paintBg } from '@/data/contactSheet';
import { getAllRolls, getAllPaintAlbums, type Painting } from '@/lib/content';
import EnlargedFrame from './EnlargedFrame.astro';
import CloudPhoto from './CloudPhoto.astro';

// Resolve photo-cell slugs to their roll cover image at build time.
// Paint cells with a `painting` id resolve to that painting's image the
// same way. Cells without either keep the placeholder gradient.
const rolls = await getAllRolls();
const coverBySlug = new Map(
  rolls.map((r) => {
    const cover = r.data.cover ?? r.data.photos[0];
    return [r.id, { cldPath: cover.cldPath, alt: cover.alt }];
  }),
);

const albums = await getAllPaintAlbums();
const albumById = new Map(albums.map((a) => [a.id, a]));
const paintingById = new Map<string, { painting: Painting; albumSlug: string }>();
for (const album of albums) {
  for (const p of album.data.paintings) {
    paintingById.set(p.id, { painting: p, albumSlug: album.id });
  }
}

const resolvedCover = (f: (typeof contactSheet)[number]) => {
  if (f.k === 'photo' && f.slug) return coverBySlug.get(f.slug);
  if (f.k === 'paint' && f.album) {
    const a = albumById.get(f.album);
    if (a) return a.data.cover ?? a.data.paintings[0].image;
  }
  if (f.k === 'paint' && f.painting) {
    const hit = paintingById.get(f.painting);
    if (hit)
      return {
        cldPath: hit.painting.image.cldPath,
        alt: hit.painting.image.alt,
      };
  }
  return undefined;
};

// Permalink for linked paint cells: album page or single-painting page.
const paintHref = (f: (typeof contactSheet)[number]) => {
  if (f.k !== 'paint') return undefined;
  if (f.album && albumById.has(f.album)) return `/paints/${f.album}`;
  if (f.painting) {
    const hit = paintingById.get(f.painting);
    if (hit) return `/paints/${hit.albumSlug}/${f.painting}`;
  }
  return undefined;
};
const paintCtaLabel = (f: (typeof contactSheet)[number]) =>
  f.k === 'paint' && f.album ? 'view album →' : 'view painting →';
---

<section
  id="sheet"
  class="
    relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2
    bg-ink-2 p-2.5 border border-ink-3 max-w-[1320px] mx-auto
  "
>
  {contactSheet.map((f, i) => {
    const dialogId = `frame-${i + 1}`;
    const cover = resolvedCover(f);
    // Roll / painting / external URL this cell points at.
    const permalink =
      f.k === 'photo' && f.slug
        ? `/lens/${f.slug}/`
        : f.k === 'paint'
          ? paintHref(f)
          : f.k === 'link'
            ? f.href
            : undefined;
    const ctaLabel =
      f.k === 'photo'
        ? 'see full roll →'
        : f.k === 'paint'
          ? paintCtaLabel(f)
          : f.k === 'link'
            ? (f.cta ?? 'open ↗')
            : undefined;
    const bgStyle = cover
      ? undefined
      : f.k === 'photo'
        ? photoBg(f.tone)
        : f.k === 'paint'
          ? paintBg(f.tone)
          : undefined;

    const indexBadge = (
      <span class="absolute top-1.5 left-1.5 z-[3] text-[10px] text-phosphor tracking-[0.12em] bg-black/60 px-1.5 py-0.5">
        {String(i + 1).padStart(2, '0')}A
      </span>
    );
    const tagBadge = (
      <span
        class:list={[
          'absolute top-1.5 right-1.5 z-[3] text-[9px] tracking-[0.14em] px-1.5 py-0.5 bg-black/50 border',
          f.k === 'paint' ? 'text-safelight border-safelight'
            : 'text-phosphor border-phosphor',
        ]}
      >
        {f.tag}
      </span>
    );

    // Code cells are non-interactive panels — no lightbox, no reveal.
    if (f.k === 'code') {
      return (
        <article class="relative aspect-[4/3] border border-ink-3 overflow-hidden">
          {indexBadge}
          {tagBadge}
          <div class="absolute inset-0 bg-[#0a0a09] pt-6 px-3.5 pb-3.5">
            <pre class="m-0 text-[11px] text-phosphor leading-[1.5] whitespace-pre-wrap">{f.text}</pre>
          </div>
        </article>
      );
    }

    // Visual cells: desktop taps open the lightbox (EnlargedFrame);
    // narrow screens reveal an in-cell layer with the caption + CTA
    // instead of a cramped modal (wiring in the script below).
    return (
      <div
        class="cell relative aspect-[4/3] border border-ink-3 overflow-hidden transition-transform duration-200 ease-[cubic-bezier(.2,.8,.2,1)] hover:scale-[1.02] focus-within:scale-[1.02]"
        style={bgStyle}
      >
        <button
          type="button"
          data-enlarge-target={dialogId}
          {...(permalink ? { 'data-permalink': permalink } : {})}
          class="absolute inset-0 w-full h-full appearance-none text-left cursor-pointer"
        >
          {cover && (
            <CloudPhoto
              cldPath={cover.cldPath}
              alt={cover.alt}
              width={800}
              class="absolute inset-0 w-full h-full"
            />
          )}
          {f.k === 'link' && (
            <img
              src={f.src}
              alt={f.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-contain bg-[#0a0a09]"
            />
          )}
          {indexBadge}
          {tagBadge}
          <span
            class:list={[
              'absolute left-2 bottom-2 z-[3] text-[10px] tracking-[0.16em] text-paper',
              f.k === 'link' && 'bg-black/60 px-1.5 py-0.5',
            ]}
          >
            {f.label}
          </span>
        </button>

        {permalink && (
          <div class="reveal-layer absolute inset-0 z-20 flex flex-col justify-end gap-2 p-3 bg-gradient-to-t from-black/90 via-black/70 to-black/25">
            {f.k === 'link' && f.note && (
              <p class="m-0 text-[11px] leading-[1.5] text-paper-2 line-clamp-5">{f.note}</p>
            )}
            <span class="text-[10px] tracking-[0.16em] text-mute-2 uppercase">{f.label}</span>
            <a
              data-cta
              href={permalink}
              {...(f.k === 'link' ? { target: '_blank', rel: 'noopener' } : {})}
              class="self-start text-[12px] tracking-[0.14em] text-phosphor border border-phosphor px-2.5 py-1 hover:bg-phosphor hover:text-black transition-colors"
            >
              {ctaLabel}
            </a>
          </div>
        )}
      </div>
    );
  })}

  {contactSheet.map((f, i) => {
    if (f.k === 'link') {
      return (
        <EnlargedFrame
          id={`frame-${i + 1}`}
          imageSrc={f.src}
          imageAlt={f.alt}
          label={f.label}
          tag={f.tag}
          caption={f.note}
          ctaHref={f.href}
          ctaLabel={f.cta ?? 'open ↗'}
          ctaExternal
        />
      );
    }
    if (f.k !== 'photo' && f.k !== 'paint') return null;
    const cover = resolvedCover(f);
    return (
      <EnlargedFrame
        id={`frame-${i + 1}`}
        frame={f}
        rollSlug={f.k === 'photo' ? f.slug : undefined}
        ctaHref={paintHref(f)}
        ctaLabel={paintCtaLabel(f)}
        imageCldPath={cover?.cldPath}
        imageAlt={cover?.alt}
        fitContain
      />
    );
  })}
</section>

<!-- Lightbox (desktop) wiring lives in EnlargedFrame.astro (one shared script). -->

<style>
  /* Reveal layer is a mobile-only affordance: on wider screens the cell
     opens the lightbox instead, so the layer never shows there. */
  .reveal-layer {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }
  .cell.is-revealed .reveal-layer {
    opacity: 1;
    pointer-events: auto;
  }
  @media (min-width: 641px) {
    .reveal-layer {
      display: none;
    }
  }
</style>

<script>
  // On narrow screens, one tap reveals the cell's caption + CTA in place
  // rather than opening a cramped lightbox. Runs in the capture phase and
  // stops the event so EnlargedFrame's document-level handler never fires
  // for these cells; desktop taps fall through to open the lightbox.
  function setupReveal() {
    const section = document.getElementById('sheet');
    if (!section || section.dataset.revealWired) return;
    section.dataset.revealWired = '1';

    const mq = window.matchMedia('(max-width: 640px)');
    const closeAll = () =>
      section
        .querySelectorAll('.cell.is-revealed')
        .forEach((c) => c.classList.remove('is-revealed'));

    section.addEventListener(
      'click',
      (e) => {
        if (!mq.matches) return; // desktop → let the lightbox handler run
        const target = e.target as Element;
        if (target.closest('[data-cta]')) return; // let the CTA navigate
        const cell = target.closest('.cell');
        if (!cell || !cell.querySelector('.reveal-layer')) return;
        e.preventDefault();
        e.stopPropagation();
        const wasOpen = cell.classList.contains('is-revealed');
        closeAll();
        if (!wasOpen) cell.classList.add('is-revealed');
      },
      true,
    );

    const onDocClick = (e: MouseEvent) => {
      if (!mq.matches) return;
      if ((e.target as Element).closest?.('#sheet .cell')) return;
      closeAll();
    };
    document.addEventListener('click', onDocClick);
    document.addEventListener(
      'astro:before-swap',
      () => document.removeEventListener('click', onDocClick),
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', setupReveal);
</script>
