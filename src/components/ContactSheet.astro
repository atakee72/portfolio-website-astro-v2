---
import { contactSheet, photoBg, paintBg } from '@/data/contactSheet';
import EnlargedFrame from './EnlargedFrame.astro';
---

<section
  id="sheet"
  class="
    relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2
    bg-ink-2 p-2.5 border border-ink-3 max-w-[1320px] mx-auto
  "
>
  {contactSheet.map((f, i) => {
    const isVisual = f.k === 'photo' || f.k === 'paint';
    const dialogId = `frame-${i + 1}`;
    const Tag = isVisual ? 'button' : 'article';
    return (
      <Tag
        {...(isVisual ? { type: 'button', 'data-enlarge-target': dialogId } : {})}
        class={
          'relative aspect-[4/3] border border-ink-3 overflow-hidden text-left appearance-none ' +
          'transition-transform duration-200 ease-[cubic-bezier(.2,.8,.2,1)] ' +
          'hover:scale-[1.02] focus-within:scale-[1.02] focus-visible:scale-[1.02]'
        }
        style={f.k === 'photo' ? photoBg(f.tone) : f.k === 'paint' ? paintBg(f.tone) : undefined}
      >
        <span class="absolute top-1.5 left-1.5 z-[3] text-[10px] text-phosphor tracking-[0.12em] bg-black/60 px-1.5 py-0.5">
          {String(i + 1).padStart(2, '0')}A
        </span>

        <span
          class:list={[
            'absolute top-1.5 right-1.5 text-[9px] tracking-[0.14em] px-1.5 py-0.5 bg-black/50 border',
            f.k === 'paint' ? 'text-safelight border-safelight'
              : f.k === 'code' ? 'text-phosphor border-phosphor'
              : 'text-paper border-paper',
          ]}
        >
          {f.tag}
        </span>

        {f.k === 'code' ? (
          <div class="absolute inset-0 bg-[#0a0a09] pt-6 px-3.5 pb-3.5">
            <pre class="m-0 text-[11px] text-phosphor leading-[1.5] whitespace-pre-wrap">{f.text}</pre>
          </div>
        ) : (
          <span class="absolute left-2 bottom-2 text-[10px] tracking-[0.16em] text-paper">
            {f.label}
          </span>
        )}
      </Tag>
    );
  })}

  {contactSheet.map((f, i) =>
    f.k === 'photo' || f.k === 'paint' ? (
      <EnlargedFrame id={`frame-${i + 1}`} frame={f} />
    ) : null,
  )}
</section>

<script>
  // Global wire-up via event delegation on `document`. Survives Astro
  // view transitions because `document` persists across navigations.
  // The flag prevents duplicate listeners if the script re-executes.
  type WiredWindow = Window & { __enlargeWired?: boolean };
  if (!(window as WiredWindow).__enlargeWired) {
    (window as WiredWindow).__enlargeWired = true;

    let activeModal: HTMLElement | null = null;
    let lastTrigger: HTMLElement | null = null;
    let inertedSiblings: HTMLElement[] = [];

    const openModal = (modal: HTMLElement, trigger: HTMLElement) => {
      lastTrigger = trigger;
      activeModal = modal;
      // Move to body so inerting siblings doesn't inert the modal itself.
      // `inert` cascades to descendants; the modal renders inside
      // `<section id="sheet">` which is inside `#home`, a direct body child.
      // Without this move, inerting `#home` blocks pointer events on the
      // modal too — only ESC (document-level keydown) would still work.
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
      modal.removeAttribute('hidden');
      // Force layout so the transition runs from the hidden state.
      void modal.offsetWidth;
      modal.setAttribute('data-open', '');
      const closeBtn = modal.querySelector<HTMLButtonElement>('[data-close]');
      closeBtn?.focus();
      // Inert every body child except the modal itself.
      inertedSiblings = [];
      for (const child of Array.from(document.body.children)) {
        const el = child as HTMLElement;
        if (el !== modal && !el.hasAttribute('inert')) {
          el.setAttribute('inert', '');
          inertedSiblings.push(el);
        }
      }
    };

    const closeModal = () => {
      if (!activeModal) return;
      const modal = activeModal;
      modal.removeAttribute('data-open');
      // Hide after the opacity transition ends so the modal stays in
      // the layout tree during the fade-out.
      window.setTimeout(() => {
        if (modal && !modal.hasAttribute('data-open')) {
          modal.setAttribute('hidden', '');
        }
      }, 230);
      for (const el of inertedSiblings) el.removeAttribute('inert');
      inertedSiblings = [];
      lastTrigger?.focus();
      activeModal = null;
    };

    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (!target) return;

      const trigger = target.closest('[data-enlarge-target]') as HTMLElement | null;
      if (trigger) {
        if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
        const id = trigger.getAttribute('data-enlarge-target');
        if (!id) return;
        const modal = document.querySelector<HTMLElement>(`[data-modal-id="${id}"]`);
        if (modal) openModal(modal, trigger);
        return;
      }

      if (target.closest('[data-close]')) {
        closeModal();
        return;
      }

      // Backdrop click: the click target is the modal element itself
      // (not a child). The frame-wrapper child blocks bubbles inside.
      if (activeModal && target === activeModal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!activeModal) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }
      if (e.key === 'Tab') {
        // Trap focus inside the modal. With a single focusable element
        // (the close button), Tab and Shift+Tab both stay on it.
        const focusable = activeModal.querySelectorAll<HTMLElement>(
          'button, [href], input, textarea, select, [tabindex]:not([tabindex="-1"])',
        );
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          last.focus();
          e.preventDefault();
        } else if (!e.shiftKey && document.activeElement === last) {
          first.focus();
          e.preventDefault();
        }
      }
    });
  }
</script>
