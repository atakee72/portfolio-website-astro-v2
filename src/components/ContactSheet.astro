---
import { contactSheet, photoBg, paintBg } from '@/data/contactSheet';
import { getAllRolls, getAllPaintAlbums, type Painting } from '@/lib/content';
import EnlargedFrame from './EnlargedFrame.astro';
import CloudPhoto from './CloudPhoto.astro';

// Resolve photo-cell slugs to their roll cover image at build time.
// Paint cells with a `painting` id resolve to that painting's image the
// same way. Cells without either keep the placeholder gradient.
const rolls = await getAllRolls();
const coverBySlug = new Map(
  rolls.map((r) => [
    r.id,
    { cldPath: r.data.cover.cldPath, alt: r.data.cover.alt },
  ]),
);

const albums = await getAllPaintAlbums();
const paintingById = new Map<string, { painting: Painting; albumSlug: string }>();
for (const album of albums) {
  for (const p of album.data.paintings) {
    paintingById.set(p.id, { painting: p, albumSlug: album.id });
  }
}

const resolvedCover = (f: (typeof contactSheet)[number]) => {
  if (f.k === 'photo' && f.slug) return coverBySlug.get(f.slug);
  if (f.k === 'paint' && f.painting) {
    const hit = paintingById.get(f.painting);
    if (hit)
      return {
        cldPath: hit.painting.image.cldPath,
        alt: hit.painting.image.alt,
      };
  }
  return undefined;
};

// /paints/<album>/<painting> permalink for linked paint cells.
const paintingHref = (f: (typeof contactSheet)[number]) => {
  if (f.k !== 'paint' || !f.painting) return undefined;
  const hit = paintingById.get(f.painting);
  return hit ? `/paints/${hit.albumSlug}/${f.painting}` : undefined;
};
---

<section
  id="sheet"
  class="
    relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2
    bg-ink-2 p-2.5 border border-ink-3 max-w-[1320px] mx-auto
  "
>
  {contactSheet.map((f, i) => {
    const isVisual = f.k === 'photo' || f.k === 'paint';
    const isLink = f.k === 'link';
    const dialogId = `frame-${i + 1}`;
    const Tag = isVisual ? 'button' : isLink ? 'a' : 'article';
    const cover = resolvedCover(f);
    const bgStyle = cover
      ? undefined
      : f.k === 'photo'
        ? photoBg(f.tone)
        : f.k === 'paint'
          ? paintBg(f.tone)
          : undefined;
    return (
      <Tag
        {...(isVisual ? { type: 'button', 'data-enlarge-target': dialogId } : {})}
        {...(f.k === 'photo' && f.slug ? { 'data-roll-slug': f.slug } : {})}
        {...(f.k === 'paint' && paintingHref(f) ? { 'data-paint-href': paintingHref(f) } : {})}
        {...(isLink ? { href: f.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
        class={
          'relative aspect-[4/3] border border-ink-3 overflow-hidden text-left appearance-none ' +
          'transition-transform duration-200 ease-[cubic-bezier(.2,.8,.2,1)] ' +
          'hover:scale-[1.02] focus-within:scale-[1.02] focus-visible:scale-[1.02]'
        }
        style={bgStyle}
      >
        {cover && (
          <CloudPhoto
            cldPath={cover.cldPath}
            alt={cover.alt}
            width={800}
            class="absolute inset-0 w-full h-full"
          />
        )}

        {f.k === 'link' && (
          <img
            src={f.src}
            alt={f.alt}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-contain bg-[#0a0a09]"
          />
        )}

        <span class="absolute top-1.5 left-1.5 z-[3] text-[10px] text-phosphor tracking-[0.12em] bg-black/60 px-1.5 py-0.5">
          {String(i + 1).padStart(2, '0')}A
        </span>

        <span
          class:list={[
            'absolute top-1.5 right-1.5 z-[3] text-[9px] tracking-[0.14em] px-1.5 py-0.5 bg-black/50 border',
            f.k === 'paint' ? 'text-safelight border-safelight'
              : f.k === 'code' ? 'text-phosphor border-phosphor'
              : f.k === 'link' ? 'text-phosphor border-phosphor'
              : 'text-paper border-paper',
          ]}
        >
          {f.tag}
        </span>

        {f.k === 'code' ? (
          <div class="absolute inset-0 bg-[#0a0a09] pt-6 px-3.5 pb-3.5">
            <pre class="m-0 text-[11px] text-phosphor leading-[1.5] whitespace-pre-wrap">{f.text}</pre>
          </div>
        ) : (
          <span
            class:list={[
              'absolute left-2 bottom-2 z-[3] text-[10px] tracking-[0.16em] text-paper',
              f.k === 'link' && 'bg-black/60 px-1.5 py-0.5',
            ]}
          >
            {f.label}
          </span>
        )}
      </Tag>
    );
  })}

  {contactSheet.map((f, i) => {
    if (f.k !== 'photo' && f.k !== 'paint') return null;
    const cover = resolvedCover(f);
    return (
      <EnlargedFrame
        id={`frame-${i + 1}`}
        frame={f}
        rollSlug={f.k === 'photo' ? f.slug : undefined}
        ctaHref={paintingHref(f)}
        ctaLabel="view painting →"
        imageCldPath={cover?.cldPath}
        imageAlt={cover?.alt}
      />
    );
  })}
</section>

<script>
  // Global wire-up via event delegation on `document`. Survives Astro
  // view transitions because `document` persists across navigations.
  // The flag prevents duplicate listeners if the script re-executes.
  type WiredWindow = Window & { __enlargeWired?: boolean };
  if (!(window as WiredWindow).__enlargeWired) {
    (window as WiredWindow).__enlargeWired = true;

    let activeModal: HTMLElement | null = null;
    let lastTrigger: HTMLElement | null = null;
    let inertedSiblings: HTMLElement[] = [];

    const openModal = (modal: HTMLElement, trigger: HTMLElement) => {
      lastTrigger = trigger;
      activeModal = modal;
      // Move to body so inerting siblings doesn't inert the modal itself.
      // `inert` cascades to descendants; the modal renders inside
      // `<section id="sheet">` which is inside `#home`, a direct body child.
      // Without this move, inerting `#home` blocks pointer events on the
      // modal too — only ESC (document-level keydown) would still work.
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
      modal.removeAttribute('hidden');
      // Force layout so the transition runs from the hidden state.
      void modal.offsetWidth;
      modal.setAttribute('data-open', '');
      const closeBtn = modal.querySelector('[data-close]') as HTMLButtonElement | null;
      closeBtn?.focus();
      // Inert every body child except the modal itself.
      inertedSiblings = [];
      for (const child of Array.from(document.body.children)) {
        const el = child as HTMLElement;
        if (el !== modal && !el.hasAttribute('inert')) {
          el.setAttribute('inert', '');
          inertedSiblings.push(el);
        }
      }
    };

    const closeModal = () => {
      if (!activeModal) return;
      const modal = activeModal;
      modal.removeAttribute('data-open');
      // Hide after the opacity transition ends so the modal stays in
      // the layout tree during the fade-out.
      window.setTimeout(() => {
        if (modal && !modal.hasAttribute('data-open')) {
          modal.setAttribute('hidden', '');
        }
      }, 230);
      for (const el of inertedSiblings) el.removeAttribute('inert');
      inertedSiblings = [];
      lastTrigger?.focus();
      activeModal = null;
    };

    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (!target) return;

      const trigger = target.closest('[data-enlarge-target]') as HTMLElement | null;
      if (trigger) {
        if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
          // No modal on mobile — but if this cell is linked to a roll or
          // a painting, tap-navigate straight to it so the affordance
          // isn't lost.
          const rollSlug = trigger.getAttribute('data-roll-slug');
          if (rollSlug) {
            window.location.href = `/lens/${rollSlug}/`;
            return;
          }
          const paintHref = trigger.getAttribute('data-paint-href');
          if (paintHref) window.location.href = paintHref;
          return;
        }
        const id = trigger.getAttribute('data-enlarge-target');
        if (!id) return;
        const modal = document.querySelector(`[data-modal-id="${id}"]`) as HTMLElement | null;
        if (modal) openModal(modal, trigger);
        return;
      }

      if (target.closest('[data-close]')) {
        closeModal();
        return;
      }

      // Backdrop click: the click target is the modal element itself
      // (not a child). The frame-wrapper child blocks bubbles inside.
      if (activeModal && target === activeModal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!activeModal) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }
      if (e.key === 'Tab') {
        // Trap focus inside the modal. With a single focusable element
        // (the close button), Tab and Shift+Tab both stay on it.
        const focusable = activeModal.querySelectorAll(
          'button, [href], input, textarea, select, [tabindex]:not([tabindex="-1"])',
        ) as NodeListOf<HTMLElement>;
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          last.focus();
          e.preventDefault();
        } else if (!e.shiftKey && document.activeElement === last) {
          first.focus();
          e.preventDefault();
        }
      }
    });
  }
</script>
