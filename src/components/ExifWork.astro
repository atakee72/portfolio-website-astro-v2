---
import { projects } from '@/data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  seeAllHref?: string;
}

const { seeAllHref } = Astro.props;

const HOME_CAP = 6;
const visible = projects.slice(0, HOME_CAP);
const hasOverflow = projects.length > HOME_CAP;
---

<section
  class="
    px-4 py-8 md:px-6 md:py-10 lg:px-9 lg:py-12
    max-w-[1320px] mx-auto
  "
>
  <div class="flex items-baseline justify-between gap-3 mb-4">
    <h2 class="m-0 text-[13px] text-mute-2 tracking-[0.18em] uppercase">
      // EXIF — work that paid the rent
    </h2>
    {seeAllHref && hasOverflow && (
      <a
        href={seeAllHref}
        class="text-[11px] text-phosphor tracking-[0.16em] uppercase hover:text-paper transition-colors shrink-0"
      >
        see all work →
      </a>
    )}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {visible.map((p, i) => (
      <ProjectCard project={p} index={i} total={visible.length} />
    ))}
  </div>
</section>
