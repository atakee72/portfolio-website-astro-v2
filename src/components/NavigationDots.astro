---
interface Props {
  active?: string;
}

const { active } = Astro.props;

const navItems = ['home', 'about', 'work', 'blog', 'testimonials', 'contact'];
---

<ul class="absolute right-0 hidden xs:flex items-end justify-center flex-col p-1 xxs:p-4">
  {navItems.map((item) => (
    <a href={`#${item}`} class="my-0 mx-4 flex group">
      <div class="hidden mb-1 mr-2 uppercase group-hover:flex text-white transition-all ease-in-out">
        {item}
      </div>
      <li
        class="w-3 h-3 rounded-full bg-white m-2 hover:bg-secondary"
        style={active === item ? { backgroundColor: '#313BAC' } : {}}
      />
    </a>
  ))}
</ul>
