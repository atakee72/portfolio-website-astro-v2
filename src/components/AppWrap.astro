---
import { cn } from '@/lib/utils';
import SocialMedia from './SocialMedia.astro';
import NavigationDots from './NavigationDots.astro';

interface Props {
  id: string;
  className?: string;
}

const { id, className } = Astro.props;
---

<div
  id={id}
  class={cn('min-h-screen flex flex-row items-center', className)}
>
  <SocialMedia />
  <div class="flex flex-1 justify-center items-center">
    <slot />
  </div>
  <NavigationDots active={id} />
</div>
