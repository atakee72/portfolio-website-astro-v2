---
---

<button
  type="button"
  data-scroll-top
  aria-label="Scroll to top"
  class="fixed bottom-6 right-6 z-chrome w-12 h-12 flex items-center justify-center text-phosphor opacity-0 pointer-events-none transition-all duration-200 hover:-translate-y-1"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="currentColor"
    shape-rendering="crispEdges"
    class="w-6 h-6"
    aria-hidden="true"
  >
    <rect x="9" y="0" width="2" height="2"></rect>
    <rect x="8" y="2" width="4" height="2"></rect>
    <rect x="7" y="4" width="6" height="2"></rect>
    <rect x="6" y="6" width="8" height="2"></rect>
    <rect x="5" y="8" width="10" height="2"></rect>
    <rect x="4" y="10" width="12" height="2"></rect>
    <rect x="3" y="12" width="14" height="2"></rect>
    <rect x="2" y="14" width="16" height="2"></rect>
    <rect x="1" y="16" width="18" height="2"></rect>
    <rect x="0" y="18" width="20" height="2"></rect>
  </svg>
</button>

<style is:global>
  [data-scroll-top].is-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  type Win = Window & { __scrollTopWired?: boolean };
  if (!(window as Win).__scrollTopWired) {
    (window as Win).__scrollTopWired = true;

    const update = () => {
      const btn = document.querySelector('[data-scroll-top]');
      if (!btn) return;
      const threshold = window.innerHeight * 0.5;
      btn.classList.toggle('is-visible', window.scrollY > threshold);
    };

    // Document-level click delegation: survives View Transitions DOM swaps
    document.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest('[data-scroll-top]');
      if (!btn) return;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', update, { passive: true });
    // Initial check + re-check after each View Transitions page swap
    update();
    document.addEventListener('astro:after-swap', update);
  }
</script>
