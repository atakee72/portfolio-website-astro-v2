---
import { CldImage } from 'astro-cloudinary';
import { cn } from '@/lib/utils';

interface Props {
  cldPath: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  /** Extra classes for the inner <img> (e.g. `h-full`). */
  imgClass?: string;
  /**
   * How the image fills its box. The underlying unpic <Image> writes this as
   * an INLINE style (default `cover`), so a Tailwind `object-*` class can
   * never override it — use this prop instead.
   */
  objectFit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  cldPath,
  alt,
  width = 2000,
  height,
  class: className,
  imgClass,
  objectFit,
  sizes,
  loading = 'lazy',
} = Astro.props;

// Watermark: © ATAK in Courier bold, white 70% opacity, bottom-right
// with 32px padding. Inline so no Cloudinary console preset is required.
const overlays = [
  {
    text: {
      text: '© ATAK',
      fontFamily: 'Courier',
      fontSize: 40,
      fontWeight: 'bold',
      color: 'white',
    },
    position: {
      gravity: 'south_east',
      x: 32,
      y: 32,
    },
    effects: [{ opacity: 70 }],
  },
];
---

<div class={cn('relative inline-block', className)}>
  <CldImage
    src={cldPath}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    quality={80}
    format="auto"
    {...(objectFit ? { objectFit } : {})}
    overlays={overlays}
    rawTransformations={['fl_strip_profile']}
    draggable="false"
    oncontextmenu="return false"
    class={cn('block w-full h-auto select-none pointer-events-none', imgClass)}
  />
  <div
    class="absolute inset-0 z-10"
    aria-hidden="true"
    oncontextmenu="return false"
  >
  </div>
</div>
