---
import { CldImage } from 'astro-cloudinary';
import { cn } from '@/lib/utils';
import { WATERMARK_OVERLAYS, STRIP_METADATA } from '@/lib/cloudinary';

interface Props {
  cldPath: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  /** Extra classes for the inner <img> (e.g. `h-full`). */
  imgClass?: string;
  /**
   * How the image fills its box. The underlying unpic <Image> writes this as
   * an INLINE style (default `cover`), so a Tailwind `object-*` class can
   * never override it — use this prop instead.
   */
  objectFit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  cldPath,
  alt,
  width = 2000,
  height,
  class: className,
  imgClass,
  objectFit,
  sizes,
  loading = 'lazy',
} = Astro.props;

// Watermark + metadata strip live in @/lib/cloudinary so the og:image
// builders share them — see ogImageUrl().
---

<div class={cn('relative inline-block', className)}>
  <CldImage
    src={cldPath}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    quality={80}
    format="auto"
    {...(objectFit ? { objectFit } : {})}
    overlays={WATERMARK_OVERLAYS}
    rawTransformations={STRIP_METADATA}
    draggable="false"
    oncontextmenu="return false"
    class={cn('block w-full h-auto select-none pointer-events-none', imgClass)}
  />
  <div
    class="absolute inset-0 z-10"
    aria-hidden="true"
    oncontextmenu="return false"
  >
  </div>
</div>
