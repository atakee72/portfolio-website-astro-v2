---
import AppWrap from './AppWrap.astro';
import BlogPostCard from './BlogPostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<AppWrap id="blog" className="!min-h-0 block">
  <section
    class="
      px-4 py-8 md:px-6 md:py-10 lg:px-9 lg:py-12
      max-w-[1320px] mx-auto
    "
  >
    <h2 class="m-0 text-[13px] text-mute-2 tracking-[0.18em] uppercase mb-4">
      // JOURNAL — latest entries
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
      {posts.map((post) => <BlogPostCard post={post} />)}
    </div>
  </section>
</AppWrap>
