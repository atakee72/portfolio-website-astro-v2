---
import AppWrap from './AppWrap.astro';
import BlogPostCard from './BlogPostCard.astro';
import { getHostname } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  seeAllHref?: string;
  hasMore?: boolean;
}

const { posts, seeAllHref, hasMore = false } = Astro.props;
const featuredPost = posts.find((p) => p.data.featured);
const gridPosts = posts.filter((p) => p !== featuredPost);
const featuredIsLinkpost = !!featuredPost?.data.externalUrl;
---

<AppWrap id="blog" className="!min-h-0 block">
  <section
    class="
      px-4 py-8 md:px-6 md:py-10 lg:px-9 lg:py-12
      max-w-[1320px] mx-auto
    "
  >
    <div class="flex items-baseline justify-between gap-3 mb-4">
      <h2 class="m-0 text-[13px] text-mute-2 tracking-[0.18em] uppercase">
        // JOURNAL — entries, dispatches, fragments
      </h2>
      {seeAllHref && hasMore && (
        <a
          href={seeAllHref}
          class="text-[11px] text-phosphor tracking-[0.16em] uppercase hover:text-paper transition-colors shrink-0"
        >
          see all entries →
        </a>
      )}
    </div>

    {featuredPost && (
      <a
        href={`/blog/${featuredPost.slug}`}
        class:list={[
          'block border border-ink-3 bg-ink-2 mb-3 transition-colors hover:bg-[#1e1e22] grid grid-cols-1 gap-0',
          featuredPost.data.mainImage && 'lg:grid-cols-[1.4fr_1fr]',
        ]}
      >
        {featuredPost.data.mainImage && (
          <img
            src={featuredPost.data.mainImage.src}
            alt={featuredPost.data.mainImage.alt}
            class="w-full h-64 lg:h-full object-cover border-b lg:border-b-0 lg:border-r border-ink-3"
          />
        )}
        <div class="p-5 flex flex-col gap-2">
          <span class="text-[10px] text-safelight tracking-[0.18em]">
            // FEATURED
          </span>
          <h3 class="font-display font-bold text-[28px] text-paper-hi tracking-[-0.02em] mt-1">
            {featuredPost.data.title}{featuredIsLinkpost && <span aria-hidden="true"> ↗</span>}
          </h3>
          <p class="text-[12px] text-paper-2">{featuredPost.data.description}</p>
          <span class="text-[11px] text-phosphor tracking-[0.12em] uppercase mt-2">
            {featuredIsLinkpost
              ? `via ${getHostname(featuredPost.data.externalUrl!)} ↗`
              : 'open frame →'}
          </span>
        </div>
      </a>
    )}

    {gridPosts.length === 0 && !featuredPost && (
      <p class="text-[12px] text-mute-2 font-mono">// no entries yet</p>
    )}

    {gridPosts.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
        {gridPosts.map((post) => <BlogPostCard post={post} />)}
      </div>
    )}
  </section>
</AppWrap>
