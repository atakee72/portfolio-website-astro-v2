---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Header from '@/components/Header.astro';
import About from '@/components/About.astro';
import Work from '@/components/Work.astro';
import Blog from '@/components/Blog.astro';
import Testimonials from '@/components/Testimonials.astro';
import Footer from '@/components/Footer.astro';
import { getAllBlogPosts, getAllTestimonials } from '@/lib/content';
import { FEATURES } from '@/lib/config';

const BLOG_HOME_CAP = 6;
const allPosts = await getAllBlogPosts();
const posts = allPosts.slice(0, BLOG_HOME_CAP);
const hasMorePosts = allPosts.length > BLOG_HOME_CAP;
const testimonials = FEATURES.SHOW_TESTIMONIALS ? await getAllTestimonials() : [];
---

<BaseLayout>
  <Navbar />
  <Header />
  <About />
  <Work seeAllHref="/work" />
  <Blog posts={posts} seeAllHref="/blog" hasMore={hasMorePosts} />
  {FEATURES.SHOW_TESTIMONIALS && <Testimonials testimonials={testimonials} />}
  <Footer />
</BaseLayout>
