---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import BlogPostCard from '@/components/BlogPostCard.astro';
import FilterStrip from '@/components/FilterStrip.astro';
import { getAllBlogPosts } from '@/lib/content';

const posts = await getAllBlogPosts();
const allTags = [...new Set(posts.flatMap((p) => p.data.categories))].sort();
---

<BaseLayout
  title="Journal — all entries"
  description={`All journal entries · ${posts.length} post${posts.length === 1 ? '' : 's'}`}
>
  <Navbar />

  <main
    class="
      px-4 pt-4 pb-6 md:px-6 md:pt-6 md:pb-7 lg:px-9 lg:pt-9 lg:pb-7
      max-w-[1320px] mx-auto
    "
  >
    <p
      class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mb-2 font-mono"
    >
      <a href="/" class="hover:text-phosphor transition-colors">// home</a>
      &nbsp;/&nbsp;journal
    </p>

    <h1
      class="m-0 font-display font-bold text-paper-hi text-[clamp(32px,5vw,56px)] tracking-[-0.02em] leading-[0.95] mb-2"
    >
      Journal
    </h1>

    <p class="text-[12px] text-mute-2 tracking-[0.14em] font-mono mb-8">
      // all entries · <span data-filter-count>{posts.length}</span> post{posts.length === 1 ? '' : 's'}
    </p>

    <FilterStrip tags={allTags} />

    {posts.length === 0 ? (
      <p class="text-[12px] text-mute-2 font-mono">// no entries yet</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3" data-filter-target>
        {posts.map((post) => (
          <div data-tags={post.data.categories.join('|')}>
            <BlogPostCard post={post} />
          </div>
        ))}
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
