---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import CloudPhoto from '@/components/CloudPhoto.astro';
import { getAllPaintings } from '@/lib/content';
import { paintAlbums } from '@/data/paintAlbums';

const paintings = await getAllPaintings();

// Albums with at least one published painting, newest series first
// (registry order — curated, like the contact sheet).
const albums = paintAlbums
  .map((album) => ({
    ...album,
    count: paintings.filter((p) => p.data.series === album.series).length,
  }))
  .filter((a) => a.count > 0);
---

<BaseLayout
  title="Paints — works on canvas, paper, and the rest"
  description="Paintings — oil, acrylic, watercolour, drawing. Studio archive, grouped in albums."
>
  <Navbar />

  <main
    class="
      px-4 pt-4 pb-6 md:px-6 md:pt-6 md:pb-7 lg:px-9 lg:pt-9 lg:pb-7
      max-w-[1320px] mx-auto
    "
  >
    <p
      class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mb-5 font-mono"
    >
      <a href="/" class="hover:text-phosphor transition-colors">// home</a>
      &nbsp;/&nbsp;paints
    </p>

    <h1
      class="m-0 font-display font-bold text-paper-hi text-[clamp(40px,7vw,80px)] tracking-[-0.03em] leading-[0.92] mb-3"
    >
      paints
    </h1>

    <p class="text-[12px] text-mute-2 tracking-[0.14em] font-mono mb-8">
      // {albums.length} album{albums.length === 1 ? '' : 's'} ·
      {paintings.length} painting{paintings.length === 1 ? '' : 's'}
    </p>

    {albums.length === 0 ? (
      <div
        class="
          bg-ink-2 border border-ink-3 px-4 py-3.5 font-mono text-[13px]
          text-mute-2 max-w-[600px]
        "
      >
        <span class="text-safelight">$</span> ls -1 paintings/
        <br />
        <span class="text-mute-2">// no albums catalogued yet — studio queue</span>
      </div>
    ) : (
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 list-none p-0 m-0">
        {albums.map((album) => (
          <li>
            <a
              href={`/paints/${album.slug}`}
              class="block relative aspect-[4/3] border border-ink-3 overflow-hidden bg-ink-2 transition-transform duration-200 ease-[cubic-bezier(.2,.8,.2,1)] hover:scale-[1.02] focus-visible:scale-[1.02]"
            >
              <CloudPhoto
                cldPath={album.cover}
                alt={album.coverAlt}
                width={1200}
                class="absolute inset-0 w-full h-full"
              />
              <span class="absolute top-1.5 left-1.5 z-[3] text-[10px] text-phosphor tracking-[0.12em] bg-black/60 px-1.5 py-0.5">
                ALBUM · {album.count}
              </span>
              <div
                class="absolute left-2 right-2 bottom-2 z-[3] flex justify-between items-end gap-2 text-[11px] tracking-[0.16em] text-paper"
              >
                <span>{album.title}</span>
                <span class="text-mute-2">{album.years}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>

  <Footer />
</BaseLayout>
