---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import CloudPhoto from '@/components/CloudPhoto.astro';
import EnlargedFrame from '@/components/EnlargedFrame.astro';
import FilterStrip from '@/components/FilterStrip.astro';
import { getAllPaintAlbums, type PaintAlbum, type Painting } from '@/lib/content';

export async function getStaticPaths() {
  const albums = await getAllPaintAlbums();
  return albums.map((album) => ({
    params: { album: album.id },
    props: { album },
  }));
}

interface Props {
  album: PaintAlbum;
}

const { album } = Astro.props;
const paintings = album.data.paintings;

const years = [...new Set(paintings.map((p) => p.year))].sort().reverse();
const subjects = [...new Set(paintings.flatMap((p) => p.subjects))].sort();
const media = [...new Set(paintings.map((p) => p.medium))].sort();

const detailHref = (p: Painting) => `/paints/${album.id}/${p.id}`;
const captionLine = (p: Painting) =>
  [p.medium, p.dimensions, p.year].filter(Boolean).join(' · ');
---

<BaseLayout
  title={`${album.data.title} — Paints`}
  description={album.data.description ?? album.data.title}
>
  <Navbar />

  <main
    class="
      px-4 pt-4 pb-6 md:px-6 md:pt-6 md:pb-7 lg:px-9 lg:pt-9 lg:pb-7
      max-w-[1320px] mx-auto
    "
  >
    <p
      class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mb-5 font-mono"
    >
      <a href="/" class="hover:text-phosphor transition-colors">// home</a>
      &nbsp;/&nbsp;
      <a href="/paints" class="hover:text-phosphor transition-colors">paints</a>
      &nbsp;/&nbsp;{album.id}
    </p>

    <h1
      class="m-0 font-display font-bold text-paper-hi text-[clamp(32px,5.5vw,64px)] tracking-[-0.03em] leading-[0.95] mb-3"
    >
      {album.data.title}
    </h1>

    <p class="text-[12px] text-mute-2 tracking-[0.14em] font-mono uppercase mb-2">
      // {album.data.years}{album.data.dimensions && ` · ${album.data.dimensions}`} ·
      <span data-filter-count>{paintings.length}</span> painting{paintings.length === 1 ? '' : 's'}
    </p>

    {album.data.description && (
      <p class="text-[13px] text-paper-2 leading-[1.6] max-w-[640px] m-0 mb-8">
        {album.data.description}
      </p>
    )}

    <FilterStrip name="year" tags={years} label="// year" />
    <FilterStrip name="subject" tags={subjects} label="// subject" />
    <FilterStrip name="medium" tags={media} label="// medium" />

    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 list-none p-0 m-0"
      data-filter-target
    >
      {paintings.map((p, i) => (
        <li
          data-filter-item
          data-filter-year={p.year}
          data-filter-subject={p.subjects.join('|')}
          data-filter-medium={p.medium}
        >
          <button
            type="button"
            data-enlarge-target={`paint-${i + 1}`}
            data-permalink={detailHref(p)}
            class="block w-full relative aspect-square border border-ink-3 overflow-hidden bg-ink-2 appearance-none text-left transition-transform duration-200 ease-[cubic-bezier(.2,.8,.2,1)] hover:scale-[1.02] focus-visible:scale-[1.02]"
          >
            <CloudPhoto
              cldPath={p.image.cldPath}
              alt={p.image.alt}
              width={1000}
              class="absolute inset-0 w-full h-full"
            />
            <span class="absolute top-1.5 left-1.5 z-[3] text-[10px] text-phosphor tracking-[0.12em] bg-black/60 px-1.5 py-0.5 uppercase">
              {p.medium}
            </span>
            <div
              class="absolute left-2 right-2 bottom-2 z-[3] flex justify-between items-end gap-2 text-[11px] tracking-[0.16em] text-paper"
            >
              <span class="truncate">{p.title}</span>
              <span class="text-mute-2 shrink-0">{p.year}</span>
            </div>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-8 text-[12px] tracking-[0.14em] text-mute-2 font-mono">
      <a href="/paints" class="hover:text-phosphor transition-colors">
        ← all albums
      </a>
    </div>
  </main>

  {paintings.map((p, i) => (
    <EnlargedFrame
      id={`paint-${i + 1}`}
      imageCldPath={p.image.cldPath}
      imageAlt={p.image.alt}
      label={p.title}
      caption={captionLine(p)}
      permalinkHref={detailHref(p)}
      ctaHref={detailHref(p)}
      ctaLabel="view painting →"
      showNav={paintings.length > 1}
      fitContain
    />
  ))}

  <Footer />
</BaseLayout>
