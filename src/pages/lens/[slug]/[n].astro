---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import CloudPhoto from '@/components/CloudPhoto.astro';
import { getAllPhotoEntries } from '@/lib/content';
import { getCldImageUrl } from 'astro-cloudinary/helpers';

export async function getStaticPaths() {
  const entries = await getAllPhotoEntries();
  return entries.map(({ rollSlug, roll, n, photo, total }) => ({
    params: { slug: rollSlug, n: String(n) },
    props: { roll, n, photo, total },
  }));
}

const { roll, n, photo, total } = Astro.props;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  });

const exifParts: string[] = [];
if (photo.exif.camera) exifParts.push(photo.exif.camera);
if (photo.exif.lens) exifParts.push(photo.exif.lens);
if (photo.exif.aperture) exifParts.push(photo.exif.aperture);
if (photo.exif.shutter) exifParts.push(photo.exif.shutter);
if (photo.exif.iso) exifParts.push(`ISO ${photo.exif.iso}`);
if (photo.exif.focalLength) exifParts.push(photo.exif.focalLength);
const exifLine = exifParts.join(' · ');

const ogImage = getCldImageUrl({
  src: photo.cldPath,
  width: 1200,
  height: 630,
  crop: 'fill',
  gravity: 'auto',
});

const pageTitle = `${roll.data.title} · frame ${n} — Lens`;
const pageDescription = photo.caption
  ? `${photo.caption} · ${roll.data.title}`
  : `Frame ${n}/${total} from ${roll.data.title} · ${roll.data.location}`;

// Prev/next (wrap-around, matches the desktop modal behavior).
const prevN = n > 1 ? n - 1 : total;
const nextN = n < total ? n + 1 : 1;
const prevHref = `/lens/${roll.id}/${prevN}`;
const nextHref = `/lens/${roll.id}/${nextN}`;
const permalinkHref = `/lens/${roll.id}/${n}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  ogType="article"
>
  <Navbar />

  <main
    class="
      px-4 pt-4 pb-6 md:px-6 md:pt-6 md:pb-7 lg:px-9 lg:pt-9 lg:pb-7
      max-w-[1320px] mx-auto
    "
  >
    <p class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mb-5 font-mono">
      <a href="/" class="hover:text-phosphor transition-colors">// home</a>
      &nbsp;/&nbsp;
      <a href="/lens" class="hover:text-phosphor transition-colors">lens</a>
      &nbsp;/&nbsp;
      <a href={`/lens/${roll.id}`} class="hover:text-phosphor transition-colors">
        {roll.id}
      </a>
      &nbsp;/&nbsp;{String(n).padStart(2, '0')}
    </p>

    <div class="relative mx-auto max-w-[1100px] border border-ink-3 overflow-hidden bg-ink-2">
      <CloudPhoto
        cldPath={photo.cldPath}
        alt={photo.alt}
        width={2000}
        loading="eager"
        class="block w-full h-auto"
      />

      {total > 1 && (
        <>
          <a
            href={prevHref}
            data-photo-prev
            aria-label="Previous photo"
            class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"></path>
            </svg>
          </a>
          <a
            href={nextHref}
            data-photo-next
            aria-label="Next photo"
            class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"></path>
            </svg>
          </a>
        </>
      )}

      <button
        type="button"
        data-copy-link={permalinkHref}
        aria-label="Copy link to this photo"
        class="copy-link-btn absolute top-3 right-3 z-20 w-9 h-9 flex items-center justify-center border border-ink-3 bg-ink-2 text-paper hover:text-phosphor transition-colors"
      >
        <svg class="copy-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z"></path>
        </svg>
        <svg class="check-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"></path>
        </svg>
        <span class="copied-label">copied</span>
      </button>

      <div class="absolute left-3 right-3 bottom-3 z-20 flex justify-between items-end gap-3 text-[12px] tracking-[0.16em] text-paper pointer-events-none">
        <div>
          <div>{String(n).padStart(2, '0')} / {String(total).padStart(2, '0')}</div>
          {photo.caption && (
            <div class="text-paper-2 normal-case tracking-[0.04em] mt-1">
              {photo.caption}
            </div>
          )}
          {exifLine && (
            <div class="text-mute-2 font-mono text-[11px] tracking-[0.08em] mt-1">
              {exifLine}
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-between sm:items-center text-[12px] tracking-[0.14em] text-mute-2 font-mono">
      <a href={`/lens/${roll.id}`} class="hover:text-phosphor transition-colors">
        ← back to {roll.data.title.toLowerCase()}
      </a>
      <span>{roll.data.location} · {fmtDate(roll.data.date)}</span>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Copy-link button: swap link icon → checkmark + "copied" flash when
     data-state="copied" (set briefly by the inline script below). */
  .copy-link-btn .check-icon,
  .copy-link-btn .copied-label {
    display: none;
  }
  .copy-link-btn[data-state='copied'] {
    background-color: #00ff66;
    color: #0d0d0c;
    border-color: #00ff66;
    width: auto;
    padding: 0 0.6rem;
    gap: 0.4rem;
  }
  .copy-link-btn[data-state='copied'] .copy-icon {
    display: none;
  }
  .copy-link-btn[data-state='copied'] .check-icon,
  .copy-link-btn[data-state='copied'] .copied-label {
    display: inline-flex;
  }
  .copy-link-btn[data-state='copied'] .copied-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>

<script>
  type WiredWindow = Window & { __photoPageWired?: boolean };
  if (!(window as WiredWindow).__photoPageWired) {
    (window as WiredWindow).__photoPageWired = true;

    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element | null)?.closest(
        '[data-copy-link]',
      ) as HTMLButtonElement | null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      const href = btn.getAttribute('data-copy-link');
      if (!href) return;
      const absoluteUrl = new URL(href, location.origin).href;

      try {
        await navigator.clipboard.writeText(absoluteUrl);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = absoluteUrl;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }

      btn.setAttribute('data-state', 'copied');
      window.setTimeout(() => btn.removeAttribute('data-state'), 1600);
    });

    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement?.tagName ?? '').toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      if (e.key === 'ArrowLeft') {
        const prev = document.querySelector('[data-photo-prev]') as HTMLAnchorElement | null;
        if (prev) {
          e.preventDefault();
          // click() routes through the View Transitions router (soft swap);
          // window.location.href would force a full page load.
          prev.click();
        }
      } else if (e.key === 'ArrowRight') {
        const next = document.querySelector('[data-photo-next]') as HTMLAnchorElement | null;
        if (next) {
          e.preventDefault();
          next.click();
        }
      }
    });
  }
</script>
