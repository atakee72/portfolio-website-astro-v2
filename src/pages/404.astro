---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { navItems } from '@/data/nav';
---

<BaseLayout
  title="404 — frame not found"
  description="The frame you're looking for doesn't exist on this roll."
>
  <Navbar />

  <main
    class="
      px-4 pt-4 pb-6 md:px-6 md:pt-6 md:pb-7 lg:px-9 lg:pt-9 lg:pb-7
      max-w-[1320px] mx-auto
    "
  >
    <p class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mb-2 font-mono">
      // ERR · 404 · FRAME NOT FOUND
    </p>

    <h1
      class="
        m-0 font-display font-bold leading-[0.88]
        text-paper-hi text-[clamp(64px,12vw,124px)] tracking-[-0.04em]
      "
    >
      404
    </h1>

    <p class="font-mono text-[13px] text-phosphor tracking-[0.08em] mt-4">
      // this frame doesn't exist on the roll
    </p>
    <p class="text-[13px] text-paper-2 mt-2 max-w-[500px] leading-[1.6]">
      The url you followed leads nowhere — could be a stale link, a typo, or a
      frame I haven't developed yet.
    </p>

    <p
      class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mt-10 mb-3 font-mono"
    >
      // try one of these
    </p>
    <ul
      class="
        flex flex-wrap gap-x-4 gap-y-2 list-none p-0 m-0
        text-[12px] tracking-[0.14em] uppercase text-paper
      "
    >
      {navItems.map((n, i) => (
        <li>
          <a href={n.href} class="hover:text-phosphor transition-colors">
            <em class="not-italic text-safelight text-[10px] mr-1.5">
              {String(i + 1).padStart(2, '0')}
            </em>
            {n.label}
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</BaseLayout>
