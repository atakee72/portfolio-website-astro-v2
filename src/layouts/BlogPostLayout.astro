---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, author, mainImage, publishedAt, categories } = post.data;

function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title={title} description={description}>
  <Navbar />
  <article class="min-h-screen py-12 px-4 md:px-6 lg:px-9">
    <div class="max-w-3xl mx-auto">
      <header class="mb-10">
        <a
          href="/#blog"
          class="inline-block mb-6 text-[11px] tracking-[0.16em] uppercase text-phosphor hover:underline"
        >
          ← back to journal
        </a>

        <h1 class="font-display font-bold text-paper-hi text-[clamp(32px,5vw,52px)] leading-[1.05] tracking-[-0.02em] mb-4">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-3 text-[11px] tracking-[0.12em] text-mute-2 mb-6">
          {author.image && (
            <img
              src={author.image}
              alt={author.name}
              class="w-9 h-9 object-cover border border-ink-3"
            />
          )}
          <span class="text-paper">{author.name}</span>
          <span class="text-mute">·</span>
          <time datetime={publishedAt.toISOString()}>{fmtDate(publishedAt)}</time>
        </div>

        {categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {categories.map((category) => (
              <span class="px-2 py-0.5 border border-phosphor text-phosphor text-[10px] tracking-[0.16em] uppercase">
                {category}
              </span>
            ))}
          </div>
        )}

        {mainImage && (
          <img
            src={mainImage.src}
            alt={mainImage.alt}
            class="w-full h-64 md:h-96 object-cover border border-ink-3"
          />
        )}
      </header>

      <div class="prose prose-invert max-w-none
        prose-headings:font-display prose-headings:text-paper-hi prose-headings:tracking-[-0.02em]
        prose-p:text-paper-2
        prose-a:text-phosphor prose-a:no-underline hover:prose-a:underline
        prose-strong:text-paper-hi
        prose-code:text-phosphor prose-code:bg-ink-2 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-none
        prose-pre:bg-ink-2 prose-pre:border prose-pre:border-ink-3 prose-pre:rounded-none">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
