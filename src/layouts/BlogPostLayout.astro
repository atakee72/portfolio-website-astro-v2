---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import { getHostname } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, author, mainImage, publishedAt, updatedAt, categories, stack, externalUrl } = post.data;
const isLinkpost = !!externalUrl;

function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const body = post.body ?? '';
const prose = body.replace(/```[\s\S]*?```/g, '');
const wordCount = prose.split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.round(wordCount / 200));

const site = Astro.site ?? new URL('https://ercan-atak.de');
const postUrl = new URL(`/blog/${post.slug}`, site).href;
const absImage = mainImage?.src
  ? new URL(mainImage.src, site).href
  : undefined;

// BlogPosting + BreadcrumbList so search engines and AI answer engines
// can attribute and cite the post. Linkposts point back to the original
// via `sameAs` rather than claiming authorship of external content.
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: postUrl,
  mainEntityOfPage: postUrl,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Person', name: author.name, url: site.origin },
  publisher: { '@type': 'Person', name: 'Ercan Atak', url: site.origin },
  ...(absImage ? { image: absImage } : {}),
  ...(categories.length ? { keywords: categories.join(', ') } : {}),
  ...(isLinkpost ? { sameAs: externalUrl } : {}),
  inLanguage: 'en',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: new URL('/blog', site).href },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={absImage}
  ogType="article"
  jsonLd={[blogPostingLd, breadcrumbLd]}
>
  <Navbar />
  <article class="min-h-screen py-12 px-4 md:px-6 lg:px-9">
    <div class="max-w-3xl mx-auto">
      <p class="text-[11px] text-mute-2 tracking-[0.18em] uppercase mb-2 font-mono">
        <a href="/" class="hover:text-phosphor transition-colors">// home</a>
        &nbsp;/&nbsp;
        <a href="/blog" class="hover:text-phosphor transition-colors">journal</a>
        &nbsp;/&nbsp;{post.slug}
      </p>

      <p class="text-[11px] text-mute-2 tracking-[0.14em] font-mono mb-4">
        // {isLinkpost ? 'reblogged by' : 'by'} {author.name} · {readTime} min read · <time datetime={publishedAt.toISOString()}>{fmtDate(publishedAt)}</time>{updatedAt && (<> · <span class="text-safelight">updated <time datetime={updatedAt.toISOString()}>{fmtDate(updatedAt)}</time></span></>)}
      </p>

      {isLinkpost && (
        <a
          href={externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mb-6 px-3 py-2 border border-phosphor text-phosphor text-[12px] tracking-[0.14em] uppercase hover:bg-phosphor hover:text-ink transition-colors"
        >
          ↗ read original at {getHostname(externalUrl!)}
        </a>
      )}

      <h1 class="font-display font-bold text-paper-hi text-[clamp(32px,5vw,52px)] leading-[1.05] tracking-[-0.02em] mb-4">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-[11px] tracking-[0.12em] text-mute-2 mb-6">
        {author.image && (
          <img
            src={author.image}
            alt={author.name}
            class="w-9 h-9 object-cover border border-ink-3"
          />
        )}
        <span class="text-paper">
          {isLinkpost && <span class="text-mute-2">reblogged by </span>}{author.name}
        </span>
      </div>

      {categories.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3">
          {categories.map((category) => (
            <span class="px-2 py-0.5 border border-phosphor text-phosphor text-[10px] tracking-[0.16em] uppercase">
              {category}
            </span>
          ))}
        </div>
      )}

      {stack.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {stack.map((tech) => (
            <span class="px-2 py-0.5 border border-safelight text-safelight text-[10px] tracking-[0.16em] uppercase">
              {tech}
            </span>
          ))}
        </div>
      )}

      {mainImage && (
        <img
          src={mainImage.src}
          alt={mainImage.alt}
          class="w-full h-auto border border-ink-3 mb-8"
        />
      )}

      <div class="prose prose-invert max-w-none
        prose-headings:font-display prose-headings:text-paper-hi prose-headings:tracking-[-0.02em]
        prose-p:text-paper-2
        prose-a:text-phosphor prose-a:no-underline hover:prose-a:underline
        prose-strong:text-paper-hi
        prose-code:text-phosphor prose-code:bg-ink-2 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-none
        prose-pre:bg-ink-2 prose-pre:border prose-pre:border-ink-3 prose-pre:rounded-none">
        <slot />
      </div>

      <footer class="mt-16 pt-6 border-t border-ink-3 flex flex-wrap justify-between gap-3 text-[11px] tracking-[0.14em] uppercase">
        <a href="/#blog" class="text-paper hover:text-phosphor transition-colors">
          ← more journal
        </a>
        <a href="/#reach-form" class="text-phosphor hover:text-paper transition-colors">
          {stack.length > 0 ? '// reach about this stack →' : '// reach out →'}
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>
