---
import { ViewTransitions } from 'astro:transitions';
import ReticleCursor from '../components/ReticleCursor.svelte';
import SocialMedia from '../components/SocialMedia.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra schema.org JSON-LD for this page (object or array), rendered
      alongside the sitewide Person graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Portfolio - Full Stack Developer',
  description = 'Full-stack developer portfolio showcasing modern web development projects and blog posts',
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// Canonical URL — absolute, no query/hash, trailing slash normalized.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// schema.org JSON-LD injected via set:html must escape `<` so a value
// containing `</script>` can't break out of the tag.
const ldJson = (obj: unknown) =>
  JSON.stringify(obj).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ercan Atak — three darkrooms"
      href="/rss.xml"
    />
    <ViewTransitions />
    <script type="application/ld+json" set:html={ldJson({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Ercan Atak',
      url: 'https://ercan-atak.de',
      jobTitle: 'Full-Stack Developer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Berlin',
        addressCountry: 'DE',
      },
      sameAs: [
        'https://github.com/atakee72',
        'https://linkedin.com/in/ercan-atak',
        'https://www.behance.net/E-Atak-Photography',
        'https://www.instagram.com/a_t_a_k_e_e/',
      ],
    })} />
    {extraJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={ldJson(obj)} />
    ))}
    <script
      is:inline
      data-goatcounter="https://stats.ercan-atak.de/count"
      data-goatcounter-settings='{"no_onload": true}'
      async
      src="https://gc.zgo.at/count.js"
    ></script>
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        if (window.goatcounter && window.goatcounter.count) {
          window.goatcounter.count();
        }
      });
    </script>
    <script is:inline>
      function obDecode(s) {
        return String.fromCharCode.apply(null, s.split(',').map(Number));
      }
      function obUnmask() {
        document.querySelectorAll('[data-ob-email]').forEach((el) => {
          if (el.dataset.done) return;
          const addr = obDecode(el.dataset.u) + '@' + obDecode(el.dataset.d);
          el.setAttribute('href', 'mailto:' + addr);
          el.textContent = addr;
          el.dataset.done = '1';
        });
        document.querySelectorAll('[data-ob-text]').forEach((el) => {
          if (el.dataset.done) return;
          el.textContent = obDecode(el.dataset.c);
          el.dataset.done = '1';
        });
      }
      document.addEventListener('astro:page-load', obUnmask);
    </script>
  </head>
  <body>
    <ReticleCursor client:only="svelte" />
    <slot />
    <SocialMedia />
    <ScrollToTop />
  </body>
</html>
