---
import { ViewTransitions } from 'astro:transitions';
import ReticleCursor from '../components/ReticleCursor.svelte';
import SocialMedia from '../components/SocialMedia.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Portfolio - Full Stack Developer',
  description = 'Full-stack developer portfolio showcasing modern web development projects and blog posts',
  ogImage,
  ogType = 'website',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ercan Atak — three darkrooms"
      href="/rss.xml"
    />
    <ViewTransitions />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Ercan Atak',
      url: 'https://ercan-atak.de',
      email: 'contact@ercan-atak.de',
      jobTitle: 'Full-Stack Developer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Berlin',
        addressCountry: 'DE',
      },
      sameAs: [
        'https://github.com/atakee72',
        'https://linkedin.com/in/ercan-atak',
        'https://www.behance.net/E-Atak-Photography',
        'https://www.instagram.com/a_t_a_k_e_e/',
      ],
    })} />
    <script
      is:inline
      data-goatcounter="https://stats.ercan-atak.de/count"
      data-goatcounter-settings='{"no_onload": true}'
      async
      src="https://gc.zgo.at/count.js"
    ></script>
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        if (window.goatcounter && window.goatcounter.count) {
          window.goatcounter.count();
        }
      });
    </script>
  </head>
  <body>
    <ReticleCursor client:only="svelte" />
    <slot />
    <SocialMedia />
    <ScrollToTop />
  </body>
</html>
