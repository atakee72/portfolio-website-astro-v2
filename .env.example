# Cloudinary — photography pipeline (/lens routes + Sveltia CMS)
# Copy to .env.local and fill in. Never commit the real values.
#
# PUBLIC_* is exposed to the client; cloud_name is not a secret.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only — used by scripts/sync-exif.mjs at build time to fetch
# EXIF from Cloudinary's Admin API for every photo in src/content/rolls/.
# Must also be set on Vercel (Production + Preview + Development) so the
# build can fetch EXIF. Do NOT add the PUBLIC_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web3Forms — contact form in About section
# Get your free access key at https://web3forms.com/
# PUBLIC_ exposes it to the client (safe: it's per-form, not a secret).
PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key
