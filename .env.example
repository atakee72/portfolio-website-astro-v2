# Cloudinary — photography pipeline (/lens routes)
# Copy to .env (or .env.local) and fill in. Never commit the real values.
#
# PUBLIC_* is exposed to the client; cloud_name is not a secret.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only — used by scripts/extract-exif.mjs and any future upload tooling.
# Do NOT add the PUBLIC_ prefix to these.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
