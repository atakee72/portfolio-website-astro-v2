{
  "name": "portfolio-astro",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-exif.mjs && astro check && astro build",
