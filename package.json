    "astro": "^5.15.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "sharp": "^0.33.2",
    "svelte": "^5.55.5",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.5",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.17.9",
    "@typescript-eslint/parser": "^8.59.3",
    "astro-cloudinary": "^1.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
