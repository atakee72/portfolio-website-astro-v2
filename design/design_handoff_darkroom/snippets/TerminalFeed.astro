---
/**
 * TerminalFeed — right-hand column of the hero. Lists the latest blog
 * posts in a shell-session style. The blinking caret at the bottom is
 * pure decoration, animated via the `.darkroom-caret` utility in
 * globals.css.
 */
import { getAllBlogPosts } from '@/lib/content';

const posts = (await getAllBlogPosts()).slice(0, 3);

function shortDate(d: Date): string {
  return d.toISOString().slice(0, 10);
}
---

<aside class="bg-ink-2 border border-ink-3 px-4 py-3.5">
  <div class="text-[10px] text-mute-2 tracking-[0.18em] pb-2.5 mb-3 border-b border-ink-3 uppercase">
    ~/journal/feed.sh
  </div>

  <pre class="m-0 text-[12px] leading-[1.7] text-paper whitespace-pre-wrap font-mono">
<span class="text-safelight">$</span> cat ~/blog/*.mdx | head
{posts.map((p) => (
  <>
    <span class="text-phosphor">▸ {shortDate(p.data.pubDate ?? new Date())}</span>  {p.data.title}{'\n'}
  </>
))}
<span class="text-safelight">$</span> whoami
ercan — full-stack, half-painter,
        based in Kreuzberg
<span class="text-safelight">$</span> uptime
Berlin, since 2014 — load avg 0.7
<span class="text-safelight">$</span> <span class="darkroom-caret"></span></pre>
</aside>
