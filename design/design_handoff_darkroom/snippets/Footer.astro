---
/**
 * Footer — Darkroom redesign.
 * One row. Three spans: roll-end marker, contact strip, copyright.
 */
const email = 'atakee@gmail.com';
const phone = '+49 30 88694300';
const place = '12049 Berlin';
const year = new Date().getFullYear();
---

<footer class="
  mt-6 pt-3.5 px-9 pb-6 border-t border-ink-3
  max-w-[1320px] mx-auto
  flex flex-col gap-2 lg:flex-row lg:justify-between
  text-[10px] tracking-[0.16em] text-mute
">
  <span class="text-safelight">FRAME 36/36 — END OF ROLL</span>
  <span>
    <a href={`mailto:${email}`} class="text-paper hover:text-phosphor">{email}</a>
    {'  ·  '}
    <a href={`tel:${phone.replace(/\s+/g, '')}`} class="text-paper hover:text-phosphor">{phone}</a>
    {'  ·  '}
    {place}
  </span>
  <span>© ATAK · {year}</span>
</footer>
