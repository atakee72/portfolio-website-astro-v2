---
/**
 * src/pages/index.astro — Darkroom redesign composition.
 *
 * Replaces the existing one-page composition. Note:
 *  - No bg-gradient-radial wrapper (the body owns the ink background now).
 *  - Testimonials section is hidden via FEATURES.SHOW_TESTIMONIALS.
 *  - The sphere div is gone.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Header from '@/components/Header.astro';
import About from '@/components/About.astro';
import ExifWork from '@/components/ExifWork.astro';
import Blog from '@/components/Blog.astro';
import Testimonials from '@/components/Testimonials.astro';
import Footer from '@/components/Footer.astro';
import ReticleCursor from '@/components/ReticleCursor.svelte';
import { getAllBlogPosts, getAllTestimonials } from '@/lib/content';
import { FEATURES } from '@/lib/config';

const posts = await getAllBlogPosts();
const testimonials = FEATURES.SHOW_TESTIMONIALS ? await getAllTestimonials() : [];
---

<BaseLayout>
  <ReticleCursor client:idle />

  <Navbar />
  <Header />
  <About />
  <ExifWork />
  <Blog posts={posts} />
  {FEATURES.SHOW_TESTIMONIALS && <Testimonials testimonials={testimonials} />}
  <Footer />
</BaseLayout>
